# ============================================================
#  HRM System — Environment Variables
#  Copy this file to .env and adjust values as needed:
#      cp .env.example .env
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=3000
APP_NAME=HRM System
APP_URL=http://localhost:3000

# ---- Database (MongoDB) ----
# Local MongoDB: mongodb://127.0.0.1:27017/hrm_system
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/hrm_system
MONGODB_URI=mongodb://127.0.0.1:27017/hrm_system

# ---- Session ----
# IMPORTANT: change this to a long random string in production.
SESSION_SECRET=insecure-dev-secret-change-me
SESSION_MAX_AGE=86400000
COOKIE_SECURE=false

# ---- Security ----
BCRYPT_SALT_ROUNDS=12

# ---- File uploads ----
UPLOAD_DIR=src/public/uploads
MAX_FILE_SIZE_MB=5

# ---- Employee ID generation ----
# Prefix used when auto-generating employee IDs (e.g. EMP0001, EMP0002).
# Defaults to "EMP" if unset.
EMPLOYEE_ID_PREFIX=EMP

# ---- Logging ----
LOG_LEVEL=debug
