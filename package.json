{
  "name": "hrm-system",
  "version": "1.3.0",
  "description": "Professional, enterprise-level Human Resource Management System built with Express, MongoDB, EJS and Tailwind CSS — Premium SaaS UI Edition.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:css": "tailwindcss -i ./src/public/css/tailwind.css -o ./src/public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/public/css/tailwind.css -o ./src/public/css/style.css --watch",
    "seed": "node seeder.js",
    "seed:force": "node seeder.js --force",
    "lint": "eslint ."
  },
  "keywords": [
    "hrm",
    "hrms",
    "human-resources",
    "express",
    "mongodb",
    "ejs",
    "tailwindcss"
  ],
  "author": "Asadullah Hameedi",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.15.0",
    "winston": "^3.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6"
  }
}
