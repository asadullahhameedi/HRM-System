<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print">
      <a href="/reports" class="hover:text-brand-600">Reports</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300">User Activity</span>
    </nav>
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">User Activity Report</h2><p class="text-sm text-slate-500">Audit log and user activity history.</p></div>
      <div class="flex gap-2 no-print">
        <a href="?format=xlsx<%= '&module=' + (filters.module||'') + '&status=' + (filters.status||'') + '&action=' + (filters.action||'') %>" class="btn-secondary btn-sm"><i class="fa-solid fa-file-excel text-emerald-600"></i> Excel</a>
        <a href="?format=csv<%= '&module=' + (filters.module||'') + '&status=' + (filters.status||'') + '&action=' + (filters.action||'') %>" class="btn-secondary btn-sm"><i class="fa-solid fa-file-csv text-sky-600"></i> CSV</a>
        <button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
      </div>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Events</div><div class="text-xl font-bold mt-1"><%= total %></div></div>
      <% byModule.slice(0,3).forEach(function(m) { %>
        <div class="card p-4"><div class="text-xs text-slate-500 uppercase"><%= m._id %></div><div class="text-xl font-bold mt-1"><%= m.count %></div></div>
      <% }) %>
    </div>

    <!-- Filters -->
    <div class="card no-print"><div class="card-body">
      <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
        <div><label class="label">Module</label><select name="module" class="input"><option value="">All</option><% ['auth','employee','attendance','leave','payroll','settings','task','document','user'].forEach(function(m){ %><option value="<%= m %>" <%= filters.module===m?'selected':'' %>><%= m %></option><% }) %></select></div>
        <div><label class="label">Action</label><input name="action" value="<%= filters.action || '' %>" class="input" placeholder="e.g. payroll.run" /></div>
        <div><label class="label">Status</label><select name="status" class="input"><option value="">All</option><option value="success" <%= filters.status==='success'?'selected':'' %>>Success</option><option value="failed" <%= filters.status==='failed'?'selected':'' %>>Failed</option></select></div>
        <div><label class="label">From</label><input type="date" name="from" value="<%= filters.from || '' %>" class="input" /></div>
        <div class="flex gap-2"><button class="btn-primary btn-sm flex-1"><i class="fa-solid fa-filter"></i> Filter</button><a href="?" class="btn-secondary btn-sm"><i class="fa-solid fa-rotate-left"></i></a></div>
      </form>
    </div></div>

    <!-- Table -->
    <div class="card"><div class="overflow-x-auto">
      <% if (items.length) { %>
        <table class="table-clean">
          <thead><tr><th>When</th><th>Actor</th><th>Module</th><th>Action</th><th>Description</th><th>IP</th><th>Status</th></tr></thead>
          <tbody>
            <% items.forEach(function(l){ %>
              <tr>
                <td class="text-xs text-slate-500 whitespace-nowrap"><%= new Date(l.createdAt).toLocaleString() %></td>
                <td><div class="text-sm font-medium"><%= l.actorName || '—' %></div><div class="text-xs text-slate-400 capitalize"><%= l.actorRole || '' %></div></td>
                <td><span class="badge bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 capitalize"><%= l.module || '—' %></span></td>
                <td class="font-mono text-xs"><%= l.action %></td>
                <td class="text-sm"><%= l.description || '—' %></td>
                <td class="text-xs text-slate-400"><%= l.ip || '—' %></td>
                <td><% if (l.status === 'failed') { %><span class="badge bg-rose-100 text-rose-700">Failed</span><% } else { %><span class="badge bg-emerald-100 text-emerald-700">Success</span><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="text-center py-16"><i class="fa-solid fa-shield-halved text-4xl text-slate-300 mb-3 block"></i><h3 class="font-medium text-slate-600 dark:text-slate-300">No activity logs found</h3><p class="text-sm text-slate-400 mt-1">Try adjusting the filters above.</p></div>
      <% } %>
    </div></div>

    <% if (totalPages > 1) { %>
      <div class="flex items-center justify-between text-sm text-slate-500">
        <div>Page <%= page %> of <%= totalPages %> (<%= total %> total)</div>
        <div class="flex gap-2">
          <% if (page > 1) { %><a href="?<%= new URLSearchParams({...filters, page: page-1}).toString() %>" class="btn-secondary btn-sm">Previous</a><% } %>
          <% if (page < totalPages) { %><a href="?<%= new URLSearchParams({...filters, page: page+1}).toString() %>" class="btn-secondary btn-sm">Next</a><% } %>
        </div>
      </div>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
