<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print"><a href="/reports" class="hover:text-brand-600">Reports</a><i class="fa-solid fa-chevron-right text-xs"></i><span class="text-slate-700 dark:text-slate-300">Deduction Report</span></nav>
    <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Deduction Report</h2><p class="text-sm text-slate-500">All deductions across the selected period(s).</p></div>
    <%- include('../reports/_filters', { filters, departments, periods, showDateRange: true }) %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Rows</div><div class="text-xl font-bold mt-1"><%= rows.length %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Deductions</div><div class="text-xl font-bold mt-1 text-rose-600"><%= currencySymbol %><%= Number(totalDeductions).toLocaleString() %></div></div>
      <div class="card p-4 bg-brand-600 text-white"><div class="text-xs uppercase opacity-80">Avg / Payslip</div><div class="text-xl font-bold mt-1"><%= currencySymbol %><%= rows.length ? Number(totalDeductions/rows.length).toFixed(0).toLocaleString() : 0 %></div></div>
    </div>
    <div class="card"><div class="overflow-x-auto">
      <% if (rows.length) { %>
        <table class="table-clean">
          <thead><tr><th>Payslip</th><th>Period</th><th>Employee</th><th>Deduction</th><th>Category</th><th class="text-right">Amount</th></tr></thead>
          <tbody>
            <% rows.slice(0,500).forEach(function(r){ %>
              <tr>
                <td class="font-mono text-xs"><%= r.payslipNo %></td>
                <td class="text-xs"><%= r.period ? r.period.name : '—' %></td>
                <td><%= r.employee ? r.employee.firstName+' '+r.employee.lastName : '—' %></td>
                <td class="text-sm"><%= r.name %></td>
                <td><span class="badge bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 text-xs"><%= r.category %></span></td>
                <td class="text-right font-medium"><%= currencySymbol %><%= Number(r.amount).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (rows.length > 500) { %><p class="text-xs text-slate-400 text-center py-3">Showing first 500 rows. Export to Excel/CSV for all <%= rows.length %> rows.</p><% } %>
      <% } else { %><div class="text-center py-12 text-slate-400 text-sm">No deductions in this range.</div><% } %>
    </div></div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
