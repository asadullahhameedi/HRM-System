<% /* Shared filter bar for report views. Pass `filters` (req.query) and
     `departments` array. Optionally pass `periods` to render a period
     dropdown. The form GETs back to the same URL so filters are bookmarkable. */ %>
<form method="get" class="card">
  <div class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
    <% if (typeof showDateRange === 'undefined' || showDateRange) { %>
      <div>
        <label class="label">From Date</label>
        <input type="date" name="from" value="<%= filters.from ? new Date(filters.from).toISOString().slice(0,10) : '' %>" class="input" />
      </div>
      <div>
        <label class="label">To Date</label>
        <input type="date" name="to" value="<%= filters.to ? new Date(filters.to).toISOString().slice(0,10) : '' %>" class="input" />
      </div>
    <% } %>
    <% if (typeof departments !== 'undefined' && departments && departments.length) { %>
      <div>
        <label class="label">Department</label>
        <select name="department" class="input">
          <option value="">All Departments</option>
          <% departments.forEach(function(d){ %>
            <option value="<%= d._id %>" <%= String(filters.department) === String(d._id) ? 'selected' : '' %>><%= d.name %></option>
          <% }) %>
        </select>
      </div>
    <% } %>
    <% if (typeof periods !== 'undefined' && periods && periods.length) { %>
      <div>
        <label class="label">Period</label>
        <select name="period" class="input">
          <option value="">All Periods</option>
          <% periods.forEach(function(p){ %>
            <option value="<%= p._id %>" <%= String(filters.period) === String(p._id) ? 'selected' : '' %>><%= p.name %></option>
          <% }) %>
        </select>
      </div>
    <% } %>
    <div class="flex gap-2">
      <button type="submit" class="btn-primary flex-1"><i class="fa-solid fa-filter"></i> Apply</button>
      <a href="?" class="btn-secondary" title="Reset filters"><i class="fa-solid fa-rotate-left"></i></a>
    </div>
  </div>
  <div class="px-4 pb-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center gap-2 text-xs">
    <span class="text-slate-400 font-medium mr-1">Export:</span>
    <a href="?format=xlsx&from=<%= filters.from ? new Date(filters.from).toISOString().slice(0,10) : '' %>&to=<%= filters.to ? new Date(filters.to).toISOString().slice(0,10) : '' %>&department=<%= filters.department || '' %>&period=<%= filters.period || '' %>" class="btn-secondary btn-sm"><i class="fa-solid fa-file-excel text-emerald-600"></i> Excel</a>
    <a href="?format=csv&from=<%= filters.from ? new Date(filters.from).toISOString().slice(0,10) : '' %>&to=<%= filters.to ? new Date(filters.to).toISOString().slice(0,10) : '' %>&department=<%= filters.department || '' %>&period=<%= filters.period || '' %>" class="btn-secondary btn-sm"><i class="fa-solid fa-file-csv text-sky-600"></i> CSV</a>
    <button type="button" onclick="HRM_Print.printPage()" class="btn-secondary btn-sm ml-auto"><i class="fa-solid fa-print"></i> Print</button>
  </div>
</form>
