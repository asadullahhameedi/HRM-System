<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print">
      <a href="/reports" class="hover:text-brand-600">Reports</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300">Payroll Register</span>
    </nav>
    <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Payroll Register</h2><p class="text-sm text-slate-500">Detailed payslip listing per period.</p></div>
    <%- include('../reports/_filters', { filters, departments, periods, showDateRange: true }) %>
    <div class="card">
      <div class="overflow-x-auto">
        <% if (payslips.length) { %>
          <table class="table-clean">
            <thead><tr><th>Payslip No</th><th>Period</th><th>Employee</th><th>Dept</th><th class="text-right">Basic</th><th class="text-right">Gross</th><th class="text-right">Deductions</th><th class="text-right">Net</th><th>Status</th></tr></thead>
            <tbody>
              <% payslips.forEach(function(p){ %>
                <tr>
                  <td class="font-mono text-xs"><%= p.payslipNo %></td>
                  <td class="text-xs"><%= p.period ? p.period.name : '—' %></td>
                  <td><div class="font-medium"><%= p.employee ? p.employee.firstName + ' ' + p.employee.lastName : '—' %></div><div class="text-xs text-slate-500"><%= p.employee ? p.employee.employeeId : '' %></div></td>
                  <td class="text-xs"><%= p.employee && p.employee.department ? p.employee.department.name : '—' %></td>
                  <td class="text-right"><%= currencySymbol %><%= Number(p.basicSalary).toLocaleString() %></td>
                  <td class="text-right"><%= currencySymbol %><%= Number(p.grossEarnings).toLocaleString() %></td>
                  <td class="text-right text-rose-600"><%= currencySymbol %><%= Number(p.totalDeductions).toLocaleString() %></td>
                  <td class="text-right font-semibold"><%= currencySymbol %><%= Number(p.netPay).toLocaleString() %></td>
                  <td><% var sc = { draft:'badge-muted', pending:'badge-warning', approved:'badge-info', paid:'badge-success', cancelled:'badge-danger' }[p.status]; %><span class="<%= sc %> capitalize text-xs"><%= p.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-12 text-slate-400 text-sm">No payslips in this range.</div>
        <% } %>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
