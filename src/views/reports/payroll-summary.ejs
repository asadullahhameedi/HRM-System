<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print">
      <a href="/reports" class="hover:text-brand-600">Reports</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300">Payroll Summary</span>
    </nav>

    <div class="flex items-center justify-between no-print">
      <div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Payroll Summary</h2>
        <p class="text-sm text-slate-500">Monthly gross / deductions / net overview.</p>
      </div>
    </div>

    <%- include('../reports/_filters', { filters, departments, showDateRange: true }) %>

    <!-- KPI strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Periods</div><div class="text-xl font-bold mt-1"><%= rows.length %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Gross</div><div class="text-xl font-bold mt-1 text-emerald-600"><%= currencySymbol %><%= Number(totals.gross).toLocaleString() %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Deductions</div><div class="text-xl font-bold mt-1 text-rose-600"><%= currencySymbol %><%= Number(totals.deductions).toLocaleString() %></div></div>
      <div class="card p-4 bg-brand-600 text-white"><div class="text-xs uppercase opacity-80">Total Net</div><div class="text-xl font-bold mt-1"><%= currencySymbol %><%= Number(totals.net).toLocaleString() %></div></div>
    </div>

    <!-- Chart -->
    <div class="card">
      <div class="card-body">
        <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-4">Monthly Trend</h3>
        <canvas id="summary-chart" height="80"></canvas>
      </div>
    </div>

    <!-- Table -->
    <div class="card">
      <div class="overflow-x-auto">
        <% if (rows.length) { %>
          <table class="table-clean">
            <thead><tr><th>Period</th><th class="text-right">Payslips</th><th class="text-right">Gross</th><th class="text-right">Deductions</th><th class="text-right">Tax</th><th class="text-right">Net</th></tr></thead>
            <tbody>
              <% rows.forEach(function(r){ %>
                <tr>
                  <td class="font-medium"><%= r.period.name %></td>
                  <td class="text-right"><%= r.count %></td>
                  <td class="text-right"><%= currencySymbol %><%= Number(r.gross).toLocaleString() %></td>
                  <td class="text-right text-rose-600"><%= currencySymbol %><%= Number(r.deductions).toLocaleString() %></td>
                  <td class="text-right"><%= currencySymbol %><%= Number(r.tax).toLocaleString() %></td>
                  <td class="text-right font-semibold"><%= currencySymbol %><%= Number(r.net).toLocaleString() %></td>
                </tr>
              <% }) %>
              <tr class="bg-slate-50 dark:bg-slate-800/50 font-semibold">
                <td>TOTAL</td>
                <td class="text-right"><%= totals.count %></td>
                <td class="text-right"><%= currencySymbol %><%= Number(totals.gross).toLocaleString() %></td>
                <td class="text-right text-rose-600"><%= currencySymbol %><%= Number(totals.deductions).toLocaleString() %></td>
                <td class="text-right"><%= currencySymbol %><%= Number(totals.tax).toLocaleString() %></td>
                <td class="text-right"><%= currencySymbol %><%= Number(totals.net).toLocaleString() %></td>
              </tr>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-12 text-slate-400 text-sm">No payroll data in this range.</div>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
  var rows = <%- JSON.stringify(rows) %>;
  var sym = '<%= currencySymbol %>';
  var labels = rows.map(function (r) { return r.period.name; });
  var ctx = document.getElementById('summary-chart');
  if (ctx) {
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          { label: 'Gross', data: rows.map(function (r) { return r.gross; }), backgroundColor: '#164bdc', borderRadius: 6 },
          { label: 'Net', data: rows.map(function (r) { return r.net; }), backgroundColor: '#10b981', borderRadius: 6 },
          { label: 'Deductions', data: rows.map(function (r) { return r.deductions; }), backgroundColor: '#ef4444', borderRadius: 6 },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'top' }, tooltip: { callbacks: { label: function (c) { return c.dataset.label + ': ' + sym + Number(c.raw).toLocaleString(); } } } },
        scales: { y: { ticks: { callback: function (v) { return sym + v.toLocaleString(); } } } },
      },
    });
  }
})();
</script>
