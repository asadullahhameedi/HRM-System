<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print">
      <a href="/reports" class="hover:text-brand-600">Reports</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300">Employee Report</span>
    </nav>
    <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Employee Report</h2><p class="text-sm text-slate-500">Headcount by department, status, type.</p></div>
    <form method="get" class="card"><div class="card-body p-4 grid grid-cols-1 sm:grid-cols-4 gap-3 items-end">
      <div><label class="label">Department</label><select name="department" class="input"><option value="">All</option><% departments.forEach(function(d){ %><option value="<%= d._id %>" <%= String(filters.department)===String(d._id)?'selected':'' %>><%= d.name %></option><% }) %></select></div>
      <div><label class="label">Status</label><select name="status" class="input"><option value="">All</option><% ['active','inactive','terminated','resigned'].forEach(function(s){ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s %></option><% }) %></select></div>
      <div><label class="label">Employment Type</label><select name="employmentType" class="input"><option value="">All</option><% ['full-time','part-time','contract','intern'].forEach(function(s){ %><option value="<%= s %>" <%= filters.employmentType===s?'selected':'' %>><%= s %></option><% }) %></select></div>
      <div class="flex gap-2 justify-end"><button class="btn-primary btn-sm"><i class="fa-solid fa-filter"></i> Filter</button><a href="?" class="btn-secondary btn-sm"><i class="fa-solid fa-rotate-left"></i></a><button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button><a href="?format=xlsx&department=<%= filters.department||'' %>&status=<%= filters.status||'' %>&employmentType=<%= filters.employmentType||'' %>" class="btn-secondary btn-sm"><i class="fa-solid fa-file-excel text-emerald-600"></i> Excel</a></div>
    </div></form>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <div class="card"><div class="card-body"><h3 class="font-semibold mb-3">Headcount by Department</h3><canvas id="dept-chart" height="160"></canvas></div></div>
      <div class="card"><div class="card-body"><h3 class="font-semibold mb-3">Status Breakdown</h3><canvas id="status-chart" height="160"></canvas></div></div>
    </div>

    <div class="card">
      <div class="overflow-x-auto">
        <% if (employees.length) { %>
          <table class="table-clean">
            <thead><tr><th>Employee ID</th><th>Name</th><th>Department</th><th>Designation</th><th>Type</th><th>Status</th><th>Joined</th></tr></thead>
            <tbody>
              <% employees.forEach(function(e){ %>
                <tr>
                  <td class="font-mono text-xs"><%= e.employeeId %></td>
                  <td class="font-medium"><%= e.firstName %> <%= e.lastName %></td>
                  <td class="text-xs"><%= e.department ? e.department.name : '—' %></td>
                  <td class="text-xs"><%= e.designation ? e.designation.name : '—' %></td>
                  <td class="text-xs capitalize"><%= e.employmentType %></td>
                  <td><% var sc = { active:'badge-success', inactive:'badge-muted', terminated:'badge-danger', resigned:'badge-warning' }[e.status]; %><span class="<%= sc %> capitalize text-xs"><%= e.status %></span></td>
                  <td class="text-xs"><%= e.joinDate ? new Date(e.joinDate).toLocaleDateString() : '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-12 text-slate-400 text-sm">No employees match these filters.</div>
        <% } %>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
  var byDept = <%- JSON.stringify(byDept) %>;
  var dctx = document.getElementById('dept-chart');
  if (dctx) new Chart(dctx, {
    type: 'doughnut',
    data: { labels: byDept.map(function (b) { return b._id || 'Unassigned'; }), datasets: [{ data: byDept.map(function (b) { return b.count; }), backgroundColor: ['#164bdc','#10b981','#f59e0b','#8b5cf6','#ef4444','#06b6d4','#ec4899','#84cc16'] }] },
    options: { plugins: { legend: { position: 'right' } }, cutout: '60%' }
  });
  var statuses = ['active','inactive','terminated','resigned'];
  var allStatuses = <%- JSON.stringify(employees.map(function(e){return e.status;})) %>;
  var sc = statuses.map(function (s) { return allStatuses.filter(function (x) { return x === s; }).length; });
  var sctx = document.getElementById('status-chart');
  if (sctx) new Chart(sctx, {
    type: 'doughnut',
    data: { labels: statuses, datasets: [{ data: sc, backgroundColor: ['#10b981','#94a3b8','#ef4444','#f59e0b'] }] },
    options: { plugins: { legend: { position: 'right' } }, cutout: '60%' }
  });
})();
</script>
