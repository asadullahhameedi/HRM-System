<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print"><a href="/reports" class="hover:text-brand-600">Reports</a><i class="fa-solid fa-chevron-right text-xs"></i><span class="text-slate-700 dark:text-slate-300">Loan Report</span></nav>
    <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Loan Report</h2><p class="text-sm text-slate-500">Outstanding loans & advances.</p></div>
    <form method="get" class="card"><div class="card-body p-4 grid grid-cols-1 sm:grid-cols-4 gap-3 items-end">
      <div><label class="label">Department</label><select name="department" class="input"><option value="">All</option><% departments.forEach(function(d){ %><option value="<%= d._id %>" <%= String(filters.department)===String(d._id)?'selected':'' %>><%= d.name %></option><% }) %></select></div>
      <div><label class="label">Type</label><select name="type" class="input"><option value="">All</option><option value="loan" <%= filters.type==='loan'?'selected':'' %>>Loan</option><option value="advance" <%= filters.type==='advance'?'selected':'' %>>Advance</option></select></div>
      <div><label class="label">Status</label><select name="status" class="input"><option value="">All</option><option value="active" <%= filters.status==='active'?'selected':'' %>>Active</option><option value="cleared" <%= filters.status==='cleared'?'selected':'' %>>Cleared</option></select></div>
      <div class="flex gap-2 justify-end"><button class="btn-primary btn-sm"><i class="fa-solid fa-filter"></i> Filter</button><button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button><a href="?format=xlsx" class="btn-secondary btn-sm"><i class="fa-solid fa-file-excel text-emerald-600"></i> Excel</a></div>
    </div></form>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Active Loans</div><div class="text-xl font-bold mt-1"><%= totals.active %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Principal</div><div class="text-xl font-bold mt-1"><%= currencySymbol %><%= Number(totals.principal).toLocaleString() %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Paid</div><div class="text-xl font-bold mt-1 text-emerald-600"><%= currencySymbol %><%= Number(totals.paid).toLocaleString() %></div></div>
      <div class="card p-4 bg-rose-600 text-white"><div class="text-xs uppercase opacity-80">Outstanding</div><div class="text-xl font-bold mt-1"><%= currencySymbol %><%= Number(totals.remaining).toLocaleString() %></div></div>
    </div>
    <div class="card"><div class="overflow-x-auto">
      <% if (loans.length) { %>
        <table class="table-clean">
          <thead><tr><th>Employee</th><th>Dept</th><th>Type</th><th class="text-right">Principal</th><th class="text-right">Installment</th><th class="text-right">Paid</th><th class="text-right">Remaining</th><th>Status</th><th>Issued</th></tr></thead>
          <tbody>
            <% loans.forEach(function(l){ %>
              <tr>
                <td><div class="font-medium"><%= l.employee ? l.employee.firstName+' '+l.employee.lastName : '—' %></div><div class="text-xs text-slate-500"><%= l.employee ? l.employee.employeeId : '' %></div></td>
                <td class="text-xs"><%= l.employee && l.employee.department ? l.employee.department.name : '—' %></td>
                <td><span class="badge bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 capitalize text-xs"><%= l.type %></span></td>
                <td class="text-right"><%= currencySymbol %><%= Number(l.principal).toLocaleString() %></td>
                <td class="text-right"><%= currencySymbol %><%= Number(l.installmentAmount).toLocaleString() %></td>
                <td class="text-right text-emerald-600"><%= currencySymbol %><%= Number(l.paidAmount).toLocaleString() %></td>
                <td class="text-right font-semibold text-rose-600"><%= currencySymbol %><%= Number(l.remainingAmount).toLocaleString() %></td>
                <td><% var sc={active:'badge-success',cleared:'badge-muted',cancelled:'badge-danger'}[l.status]; %><span class="<%= sc %> capitalize text-xs"><%= l.status %></span></td>
                <td class="text-xs"><%= l.issuedDate ? new Date(l.issuedDate).toLocaleDateString() : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %><div class="text-center py-12 text-slate-400 text-sm">No loans match these filters.</div><% } %>
    </div></div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
