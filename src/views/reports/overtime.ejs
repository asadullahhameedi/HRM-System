<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print"><a href="/reports" class="hover:text-brand-600">Reports</a><i class="fa-solid fa-chevron-right text-xs"></i><span class="text-slate-700 dark:text-slate-300">Overtime Report</span></nav>
    <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Overtime Report</h2><p class="text-sm text-slate-500">Overtime hours per employee.</p></div>
    <%- include('../reports/_filters', { filters, departments, showDateRange: true }) %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <div class="card"><div class="card-body"><h3 class="font-semibold mb-3">Top OT Earners</h3><canvas id="ot-chart" height="200"></canvas></div></div>
      <div class="card"><div class="card-body"><h3 class="font-semibold mb-3">Recent OT Records</h3>
        <div class="space-y-2 max-h-80 overflow-y-auto">
          <% records.slice(0,20).forEach(function(r){ %>
            <div class="flex items-center justify-between text-sm border-b border-slate-100 dark:border-slate-800 py-2">
              <div><div class="font-medium"><%= r.employee ? r.employee.firstName+' '+r.employee.lastName : '—' %></div><div class="text-xs text-slate-500"><%= new Date(r.date).toLocaleDateString() %></div></div>
              <div class="text-right"><div class="font-bold text-amber-600"><%= r.overtimeHours %>h</div><div class="text-xs text-slate-400"><%= r.workHours %>h total</div></div>
            </div>
          <% }) %>
        </div>
      </div></div>
    </div>
    <div class="card"><div class="overflow-x-auto">
      <% if (records.length) { %>
        <table class="table-clean">
          <thead><tr><th>Date</th><th>Employee</th><th>Dept</th><th class="text-right">OT Hrs</th><th class="text-right">Work Hrs</th></tr></thead>
          <tbody>
            <% records.forEach(function(r){ %>
              <tr><td class="text-xs"><%= new Date(r.date).toLocaleDateString() %></td><td><%= r.employee ? r.employee.firstName+' '+r.employee.lastName : '—' %></td><td class="text-xs"><%= r.employee && r.employee.department ? r.employee.department.name : '—' %></td><td class="text-right font-bold text-amber-600"><%= r.overtimeHours %></td><td class="text-right text-xs"><%= r.workHours %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %><div class="text-center py-12 text-slate-400 text-sm">No overtime recorded in this range.</div><% } %>
    </div></div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
  var top = <%- JSON.stringify(topOt) %>;
  var ctx = document.getElementById('ot-chart');
  if (ctx && top.length) new Chart(ctx, {
    type: 'bar',
    data: { labels: top.map(function (t) { return t.employee ? t.employee.firstName + ' ' + t.employee.lastName : '?'; }), datasets: [{ label: 'OT Hours', data: top.map(function (t) { return t.totalHours; }), backgroundColor: '#f59e0b', borderRadius: 6 }] },
    options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { ticks: { callback: function (v) { return v + 'h'; } } } } }
  });
})();
</script>
