<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print">
      <a href="/reports" class="hover:text-brand-600">Reports</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300">Salary Report</span>
    </nav>
    <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Salary Report</h2><p class="text-sm text-slate-500">Active salary structures by employee.</p></div>
    <form method="get" class="card"><div class="card-body p-4 grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
      <div><label class="label">Department</label><select name="department" class="input"><option value="">All</option><% departments.forEach(function(d){ %><option value="<%= d._id %>" <%= String(filters.department)===String(d._id)?'selected':'' %>><%= d.name %></option><% }) %></select></div>
      <div class="sm:col-span-2 flex gap-2 justify-end"><button class="btn-primary btn-sm"><i class="fa-solid fa-filter"></i> Filter</button><a href="?" class="btn-secondary btn-sm"><i class="fa-solid fa-rotate-left"></i></a><button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button><a href="?format=xlsx&department=<%= filters.department||'' %>" class="btn-secondary btn-sm"><i class="fa-solid fa-file-excel text-emerald-600"></i> Excel</a><a href="?format=csv&department=<%= filters.department||'' %>" class="btn-secondary btn-sm"><i class="fa-solid fa-file-csv text-sky-600"></i> CSV</a></div>
    </div></form>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Employees</div><div class="text-xl font-bold mt-1"><%= structures.length %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Basic</div><div class="text-xl font-bold mt-1 text-emerald-600"><%= currencySymbol %><%= Number(totals.basic).toLocaleString() %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Allowances</div><div class="text-xl font-bold mt-1 text-sky-600"><%= currencySymbol %><%= Number(totals.allowances).toLocaleString() %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Deductions</div><div class="text-xl font-bold mt-1 text-rose-600"><%= currencySymbol %><%= Number(totals.deductions).toLocaleString() %></div></div>
    </div>

    <div class="card">
      <div class="overflow-x-auto">
        <% if (structures.length) { %>
          <table class="table-clean">
            <thead><tr><th>Employee</th><th>Dept</th><th class="text-right">Basic</th><th class="text-right">Allowances</th><th class="text-right">Bonuses</th><th class="text-right">Deductions</th><th class="text-right">Tax %</th></tr></thead>
            <tbody>
              <% structures.forEach(function(s){ %>
                <tr>
                  <td><div class="font-medium"><%= s.employee ? s.employee.firstName+' '+s.employee.lastName : '—' %></div><div class="text-xs text-slate-500"><%= s.employee ? s.employee.employeeId : '' %></div></td>
                  <td class="text-xs"><%= s.employee && s.employee.department ? s.employee.department.name : '—' %></td>
                  <td class="text-right"><%= currencySymbol %><%= Number(s.basicSalary).toLocaleString() %></td>
                  <td class="text-right"><%= currencySymbol %><%= Number((s.allowances||[]).reduce(function(a,b){return a+b.amount;},0)).toLocaleString() %></td>
                  <td class="text-right"><%= currencySymbol %><%= Number((s.bonuses||[]).reduce(function(a,b){return a+b.amount;},0)).toLocaleString() %></td>
                  <td class="text-right text-rose-600"><%= currencySymbol %><%= Number((s.deductions||[]).reduce(function(a,b){return a+b.amount;},0)).toLocaleString() %></td>
                  <td class="text-right"><%= s.taxPercent || 0 %>%</td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-12 text-slate-400 text-sm">No active salary structures.</div>
        <% } %>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
