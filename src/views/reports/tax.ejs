<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print"><a href="/reports" class="hover:text-brand-600">Reports</a><i class="fa-solid fa-chevron-right text-xs"></i><span class="text-slate-700 dark:text-slate-300">Tax Report</span></nav>
    <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Tax Report</h2><p class="text-sm text-slate-500">Tax collected per period.</p></div>
    <%- include('../reports/_filters', { filters, departments, periods, showDateRange: true }) %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Payslips with Tax</div><div class="text-xl font-bold mt-1"><%= payslips.length %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Gross (taxed)</div><div class="text-xl font-bold mt-1 text-emerald-600"><%= currencySymbol %><%= Number(payslips.reduce(function(s,p){return s+p.grossEarnings;},0)).toLocaleString() %></div></div>
      <div class="card p-4 bg-amber-500 text-white"><div class="text-xs uppercase opacity-80">Total Tax Collected</div><div class="text-xl font-bold mt-1"><%= currencySymbol %><%= Number(totalTax).toLocaleString() %></div></div>
    </div>
    <div class="card"><div class="card-body"><h3 class="font-semibold mb-3">Tax by Period</h3><canvas id="tax-chart" height="80"></canvas></div></div>
    <div class="card"><div class="overflow-x-auto">
      <% if (payslips.length) { %>
        <table class="table-clean">
          <thead><tr><th>Payslip No</th><th>Period</th><th>Employee</th><th class="text-right">Gross</th><th class="text-right">Tax %</th><th class="text-right">Tax Amount</th></tr></thead>
          <tbody>
            <% payslips.forEach(function(p){ %>
              <tr>
                <td class="font-mono text-xs"><%= p.payslipNo %></td>
                <td class="text-xs"><%= p.period ? p.period.name : '—' %></td>
                <td><%= p.employee ? p.employee.firstName+' '+p.employee.lastName : '—' %></td>
                <td class="text-right"><%= currencySymbol %><%= Number(p.grossEarnings).toLocaleString() %></td>
                <td class="text-right"><%= p.tax.percent %>%</td>
                <td class="text-right font-semibold text-amber-600"><%= currencySymbol %><%= Number(p.tax.amount).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %><div class="text-center py-12 text-slate-400 text-sm">No taxable payslips in this range.</div><% } %>
    </div></div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
  var byPeriod = <%- JSON.stringify(byPeriod) %>;
  var ctx = document.getElementById('tax-chart');
  if (ctx && byPeriod.length) {
    // Resolve period names from the payslips data passed to the view via the
    // global variable below.
    var payslipPeriods = <%- JSON.stringify(payslips.map(function(p){return {id:String(p.period?._id||''),name:p.period?.name||''};})) %>;
    var pmap = {}; payslipPeriods.forEach(function (p) { pmap[p.id] = p.name; });
    new Chart(ctx, {
      type: 'bar',
      data: { labels: byPeriod.map(function (b) { return pmap[String(b._id)] || 'period'; }), datasets: [{ label: 'Tax Collected', data: byPeriod.map(function (b) { return b.tax; }), backgroundColor: '#f59e0b', borderRadius: 6 }] },
      options: { plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: function (v) { return '<%= currencySymbol %>' + v.toLocaleString(); } } } } }
    });
  }
})();
</script>
