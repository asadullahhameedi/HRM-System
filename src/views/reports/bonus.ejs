<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print">
      <a href="/reports" class="hover:text-brand-600">Reports</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300">Bonus Report</span>
    </nav>
    <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Bonus Report</h2><p class="text-sm text-slate-500">All bonuses paid across the selected period(s).</p></div>
    <%- include('../reports/_filters', { filters, departments, periods, showDateRange: true }) %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Bonus Rows</div><div class="text-xl font-bold mt-1"><%= rows.length %></div></div>
      <div class="card p-4"><div class="text-xs text-slate-500 uppercase">Total Bonus Paid</div><div class="text-xl font-bold mt-1 text-emerald-600"><%= currencySymbol %><%= Number(totalBonus).toLocaleString() %></div></div>
      <div class="card p-4 bg-brand-600 text-white"><div class="text-xs uppercase opacity-80">Avg / Payout</div><div class="text-xl font-bold mt-1"><%= currencySymbol %><%= rows.length ? Number(totalBonus/rows.length).toFixed(0).toLocaleString() : 0 %></div></div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      <div class="card lg:col-span-1"><div class="card-body"><h3 class="font-semibold mb-3">Top Bonus Earners</h3><canvas id="bonus-chart" height="220"></canvas></div></div>
      <div class="card lg:col-span-2"><div class="overflow-x-auto">
        <% if (rows.length) { %>
          <table class="table-clean">
            <thead><tr><th>Payslip</th><th>Period</th><th>Employee</th><th>Dept</th><th>Bonus</th><th class="text-right">Amount</th></tr></thead>
            <tbody>
              <% rows.slice(0,200).forEach(function(r){ %>
                <tr>
                  <td class="font-mono text-xs"><%= r.payslipNo %></td>
                  <td class="text-xs"><%= r.period ? r.period.name : '—' %></td>
                  <td><%= r.employee ? r.employee.firstName + ' ' + r.employee.lastName : '—' %></td>
                  <td class="text-xs"><%= r.employee && r.employee.department ? r.employee.department.name : '—' %></td>
                  <td class="text-sm"><%= r.name %></td>
                  <td class="text-right font-medium text-emerald-600"><%= currencySymbol %><%= Number(r.amount).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <% if (rows.length > 200) { %><p class="text-xs text-slate-400 text-center py-3">Showing first 200 rows. Export for all <%= rows.length %> rows.</p><% } %>
        <% } else { %><div class="text-center py-12 text-slate-400 text-sm">No bonuses in this range.</div><% } %>
      </div></div>
    </div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
  var byEmployee = <%- JSON.stringify(byEmployee) %>;
  var ctx = document.getElementById('bonus-chart');
  if (ctx && byEmployee.length) new Chart(ctx, {
    type: 'bar',
    data: {
      labels: byEmployee.map(function (e) { return e.employee ? e.employee.firstName + ' ' + e.employee.lastName : '?'; }).slice(0, 10),
      datasets: [{ label: 'Total Bonus', data: byEmployee.map(function (e) { return e.total; }).slice(0, 10), backgroundColor: '#10b981', borderRadius: 6 }]
    },
    options: { indexAxis: 'y', plugins: { legend: { display: false } } }
  });
})();
</script>
