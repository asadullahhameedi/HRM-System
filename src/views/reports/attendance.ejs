<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print"><a href="/reports" class="hover:text-brand-600">Reports</a><i class="fa-solid fa-chevron-right text-xs"></i><span class="text-slate-700 dark:text-slate-300">Attendance Report</span></nav>
    <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Attendance Report</h2><p class="text-sm text-slate-500">Daily attendance status breakdown.</p></div>
    <%- include('../reports/_filters', { filters, departments, showDateRange: true }) %>
    <div class="grid grid-cols-2 sm:grid-cols-6 gap-3">
      <% byStatus.forEach(function(s){ %>
        <div class="card p-3"><div class="text-xs text-slate-500 capitalize"><%= s._id %></div><div class="text-lg font-bold mt-1"><%= s.count %></div><% if (s.otHours) { %><div class="text-xs text-amber-600"><%= s.otHours %>h OT</div><% } %></div>
      <% }) %>
    </div>
    <div class="card"><div class="overflow-x-auto">
      <% if (records.length) { %>
        <table class="table-clean">
          <thead><tr><th>Date</th><th>Employee</th><th>Status</th><th>Check In</th><th>Check Out</th><th class="text-right">Work Hrs</th><th class="text-right">OT Hrs</th><th class="text-right">Late</th></tr></thead>
          <tbody>
            <% records.forEach(function(r){ %>
              <tr>
                <td class="text-xs"><%= new Date(r.date).toLocaleDateString() %></td>
                <td><div class="font-medium"><%= r.employee ? r.employee.firstName+' '+r.employee.lastName : '—' %></div><div class="text-xs text-slate-500"><%= r.employee ? r.employee.employeeId : '' %></div></td>
                <td><% var sc={present:'badge-success',absent:'badge-danger',late:'badge-warning','half-day':'badge-info',leave:'badge-muted',holiday:'badge-muted'}[r.status]; %><span class="<%= sc %> capitalize text-xs"><%= r.status %></span></td>
                <td class="text-xs"><%= r.checkIn ? new Date(r.checkIn).toLocaleTimeString() : '—' %></td>
                <td class="text-xs"><%= r.checkOut ? new Date(r.checkOut).toLocaleTimeString() : '—' %></td>
                <td class="text-right text-xs"><%= r.workHours %></td>
                <td class="text-right text-xs"><%= r.overtimeHours %></td>
                <td class="text-right text-xs"><%= r.lateMinutes %>m</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %><div class="text-center py-12 text-slate-400 text-sm">No attendance records in this range.</div><% } %>
    </div></div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
