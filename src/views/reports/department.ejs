<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>
  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-6xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print"><a href="/reports" class="hover:text-brand-600">Reports</a><i class="fa-solid fa-chevron-right text-xs"></i><span class="text-slate-700 dark:text-slate-300">Department Report</span></nav>
    <div class="flex items-center justify-between">
      <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Department Report</h2><p class="text-sm text-slate-500">Headcount and total basic salary by department.</p></div>
      <div class="flex gap-2"><a href="?format=xlsx" class="btn-secondary btn-sm"><i class="fa-solid fa-file-excel text-emerald-600"></i> Excel</a><a href="?format=csv" class="btn-secondary btn-sm"><i class="fa-solid fa-file-csv text-sky-600"></i> CSV</a><button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button></div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <div class="card"><div class="card-body"><h3 class="font-semibold mb-3">Headcount by Department</h3><canvas id="head-chart" height="200"></canvas></div></div>
      <div class="card"><div class="card-body"><h3 class="font-semibold mb-3">Total Basic Salary by Department</h3><canvas id="sal-chart" height="200"></canvas></div></div>
    </div>
    <div class="card"><div class="overflow-x-auto">
      <% if (rows.length) { %>
        <table class="table-clean">
          <thead><tr><th>Department</th><th>Code</th><th class="text-right">Total</th><th class="text-right">Active</th><th class="text-right">Inactive</th><th class="text-right">Basic Salary Total</th></tr></thead>
          <tbody>
            <% rows.forEach(function(r){ %>
              <tr>
                <td class="font-medium"><%= r.department.name %></td>
                <td class="font-mono text-xs"><%= r.department.code %></td>
                <td class="text-right"><%= r.total %></td>
                <td class="text-right text-emerald-600"><%= r.active %></td>
                <td class="text-right text-slate-400"><%= r.inactive %></td>
                <td class="text-right font-semibold"><%= currencySymbol %><%= Number(r.basicTotal).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %><div class="text-center py-12 text-slate-400 text-sm">No departments found.</div><% } %>
    </div></div>
  </main>
  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
  var rows = <%- JSON.stringify(rows) %>;
  var sym = '<%= currencySymbol %>';
  var labels = rows.map(function (r) { return r.department.name; });
  var hctx = document.getElementById('head-chart');
  if (hctx) new Chart(hctx, {
    type: 'bar',
    data: { labels: labels, datasets: [{ label: 'Active', data: rows.map(function (r) { return r.active; }), backgroundColor: '#10b981', borderRadius: 6 }, { label: 'Inactive', data: rows.map(function (r) { return r.inactive; }), backgroundColor: '#94a3b8', borderRadius: 6 }] },
    options: { plugins: { legend: { position: 'top' } } }
  });
  var sctx = document.getElementById('sal-chart');
  if (sctx) new Chart(sctx, {
    type: 'bar',
    data: { labels: labels, datasets: [{ label: 'Total Basic', data: rows.map(function (r) { return r.basicTotal; }), backgroundColor: '#164bdc', borderRadius: 6 }] },
    options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { ticks: { callback: function (v) { return sym + v.toLocaleString(); } } } } }
  });
})();
</script>
