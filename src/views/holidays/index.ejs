
<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/dashboard" class="hover:text-brand-600">Dashboard</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-slate-700 dark:text-slate-300 font-medium">Holidays</span>
        </div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Holidays</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400"><%= pagination.total %> total holidays</p>
      </div>
      <div class="flex gap-2 no-print">
        <button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
        <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
          <button class="btn-primary btn-sm" data-modal-open="holiday-modal" data-modal-title="Add Holiday"><i class="fa-solid fa-plus"></i> Add Holiday</button>
        <% } %>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <% if (holidays.length) { %>
          <table class="table-clean">
            <thead><tr><th>Name</th><th>Date</th><th>Type</th><th>Recurring</th><th>Description</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
              <% holidays.forEach(function(h) { %>
                <tr>
                  <td class="font-medium"><%= h.name %></td>
                  <td class="text-sm"><%= new Date(h.date).toLocaleDateString() %></td>
                  <td><span class="badge-info capitalize"><%= h.type %></span></td>
                  <td><%- h.isRecurring ? '<span class="badge-success">Yes</span>' : '<span class="badge-muted">No</span>' %></td>
                  <td class="text-sm text-slate-500 max-w-xs truncate"><%= h.description || '—' %></td>
                  <td class="text-right">
                    <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
                      <button class="btn-icon btn-ghost btn-sm" data-modal-open="holiday-modal" data-modal-title="Edit Holiday" data-modal-id="<%= h._id %>" data-modal-name="<%= h.name %>" data-modal-date="<%= new Date(h.date).toISOString().slice(0,10) %>" data-modal-type="<%= h.type %>" data-modal-recurring="<%= h.isRecurring %>" data-modal-description="<%= h.description || '' %>"><i class="fa-solid fa-pen"></i></button>
                    <% } %>
                    <% if (user.role === 'admin') { %>
                      <button class="btn-icon btn-ghost btn-sm text-rose-600" data-confirm="Delete holiday '<%= h.name %>'?" data-confirm-action="/holidays/<%= h._id %>?_method=DELETE" data-confirm-method="POST"><i class="fa-solid fa-trash"></i></button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-20">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i class="fa-regular fa-calendar text-2xl text-slate-400"></i>
            </div>
            <h3 class="font-semibold text-slate-700 dark:text-slate-300">No holidays defined</h3>
            <p class="text-sm text-slate-400 mt-1">Add holidays to track non-working days.</p>
          </div>
        <% } %>
      </div>
    </div>

    <%- include('../partials/pagination', { pagination, query: filters }) %>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<%- include('../partials/confirm-modal') %>

<div id="holiday-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" data-modal-close></div>
  <div class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-2xl w-full max-w-lg p-6 animate-scale-in">
    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-4" id="holiday-modal-title">Add Holiday</h3>
    <form id="holiday-form" method="post" action="/holidays" class="space-y-3">
      <input type="hidden" name="_method" id="holiday-method" value="POST" />
      <input type="hidden" name="id" id="holiday-id" />
      <div><label class="label">Name *</label><input name="name" id="holiday-name" class="input" required /></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="label">Date *</label><input type="date" name="date" id="holiday-date" class="input" required /></div>
        <div><label class="label">Type</label><select name="type" id="holiday-type" class="input"><% ['national','religious','company','other'].forEach(function(t){ %><option value="<%= t %>"><%= t %></option><% }) %></select></div>
      </div>
      <div><label class="label flex items-center gap-2"><input type="checkbox" name="isRecurring" id="holiday-recurring" class="rounded border-slate-300 text-brand-600" /> Recurs yearly</label></div>
      <div><label class="label">Description</label><textarea name="description" id="holiday-description" class="input" rows="2"></textarea></div>
      <div class="flex justify-end gap-2 pt-2"><button type="button" class="btn-secondary" data-modal-close>Cancel</button><button class="btn-primary">Save</button></div>
    </form>
  </div>
</div>
