<!DOCTYPE html>
<html lang="en" class="<%= theme === 'dark' ? 'dark' : '' %>"<% if (typeof settingsMap !== 'undefined' && settingsMap.appearance && settingsMap.appearance.rtlEnabled) { %> dir="rtl"<% } %>>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0f172a" />
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= appName %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/vendor/@fortawesome/fontawesome-free/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <% if (typeof fontFamily !== 'undefined' && fontFamily && fontFamily !== 'Inter') { %>
    <link href="https://fonts.googleapis.com/css2?family=<%= fontFamily %>:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <% } %>
  <%
    // ---- Color helpers ----
    function hexToRgb(h){h=h.replace('#','');if(h.length===3)h=h.split('').map(function(c){return c+c;}).join('');var n=parseInt(h,16);return {r:(n>>16)&255,g:(n>>8)&255,b:n&255};}
    function rgbToHex(r,g,b){return '#'+[r,g,b].map(function(x){x=Math.max(0,Math.min(255,Math.round(x)));return ('0'+x.toString(16)).slice(-2);}).join('');}
    function mix(c1,c2,pct){var a=hexToRgb(c1),b=hexToRgb(c2);return rgbToHex(a.r+(b.r-a.r)*pct/100,a.g+(b.g-a.g)*pct/100,a.b+(b.b-a.b)*pct/100);}

    // ---- Resolve appearance settings ----
    var appearance = (typeof settingsMap !== 'undefined' && settingsMap.appearance) || {};
    var primary    = appearance.primaryColor    || (typeof primaryColor    !== 'undefined' && primaryColor)    || '#164bdc';
    var secondary  = appearance.secondaryColor  || (typeof secondaryColor  !== 'undefined' && secondaryColor)  || '#0ea5e9';
    var accent     = appearance.accentColor     || '#8b5cf6';
    var success    = appearance.successColor    || '#10b981';
    var warning    = appearance.warningColor    || '#f59e0b';
    var error      = appearance.errorColor      || '#ef4444';
    var info       = appearance.infoColor       || '#06b6d4';
    var sidebarBg  = appearance.sidebarColor    || '#0f172a';
    var headerBg   = appearance.headerColor     || primary;
    var pageBg     = appearance.backgroundColor || '#f8fafc';
    var cardBg     = appearance.cardColor       || '#ffffff';

    // ---- Generate brand shade palette (50→950) from the primary color ----
    var brandShades = {
      50:  mix(primary, '#ffffff', 88),
      100: mix(primary, '#ffffff', 75),
      200: mix(primary, '#ffffff', 55),
      300: mix(primary, '#ffffff', 35),
      400: mix(primary, '#ffffff', 15),
      500: primary,
      600: mix(primary, '#000000', 8),
      700: mix(primary, '#000000', 18),
      800: mix(primary, '#000000', 28),
      900: mix(primary, '#000000', 38),
    };

    // ---- Layout knobs ----
    var fontFam   = appearance.fontFamily    || (typeof fontFamily !== 'undefined' && fontFamily) || 'Inter';
    var fontSize  = appearance.fontSize      || '14px';
    var radius    = appearance.borderRadius  || '0.5rem';
    var cardStyle = appearance.cardStyle     || 'shadow';
    var shadow    = appearance.shadowStyle   || 'soft';
    var layoutW   = appearance.layoutWidth   || 'boxed';
    var sidebarPos= appearance.sidebarPosition || 'left';
    var sidebarW  = appearance.sidebarWidth  || 'default';
    var density   = appearance.layoutDensity || 'comfortable';

    // ---- Shadow definitions ----
    var shadowMap = {
      none:   'none',
      soft:   '0 1px 2px 0 rgba(15,23,42,0.04), 0 1px 3px 0 rgba(15,23,42,0.03)',
      medium: '0 4px 6px -1px rgba(15,23,42,0.07), 0 2px 4px -1px rgba(15,23,42,0.04)',
      hard:   '0 10px 15px -3px rgba(15,23,42,0.08), 0 4px 6px -2px rgba(15,23,42,0.04)',
    };
    var cardShadow = cardStyle === 'shadow' ? (shadowMap[shadow] || shadowMap.soft) : 'none';
    var cardBorder = cardStyle === 'border' ? '1px solid #e2e8f0' : '1px solid transparent';

    // ---- Sidebar width map ----
    var sidebarWidthMap = { compact: '5rem', default: '16rem', wide: '20rem' };
    var sbWidth = sidebarWidthMap[sidebarW] || sidebarWidthMap.default;
  %>
  <style>
    :root {
      /* Brand palette (shades derived from primary) */
      <% Object.keys(brandShades).forEach(function(shade){ %>--brand-<%= shade %>: <%= brandShades[shade] %>;
      <% }) %>

      /* Semantic colors */
      --primary-color:   <%= primary %>;
      --secondary-color: <%= secondary %>;
      --accent-color:    <%= accent %>;
      --success-color:   <%= success %>;
      --warning-color:   <%= warning %>;
      --error-color:     <%= error %>;
      --info-color:      <%= info %>;

      /* Layout surfaces */
      --sidebar-bg: <%= sidebarBg %>;
      --header-bg:  <%= headerBg %>;
      --page-bg:    <%= pageBg %>;
      --card-bg:    <%= cardBg %>;

      /* Typography */
      --app-font-family: <%= fontFam %>, 'Inter', system-ui, sans-serif;
      --app-font-size:   <%= fontSize %>;

      /* Layout knobs */
      --app-radius:     <%= radius %>;
      --app-card-shadow: <%= cardShadow %>;
      --app-card-border: <%= cardBorder %>;
      --sidebar-width:  <%= sbWidth %>;

      /* Density-aware spacing */
      --app-spacing-y: <%= density === 'compact' ? '0.5rem' : '1rem' %>;
      --app-spacing-x: <%= density === 'compact' ? '0.75rem' : '1.25rem' %>;
    }

    body {
      font-family: var(--app-font-family);
      font-size: var(--app-font-size);
      background-color: var(--page-bg);
    }
    <% if (layoutW === 'fluid') { %>
    main { max-width: 100% !important; }
    <% } %>

    /* Apply density to common spacing utilities */
    <% if (density === 'compact') { %>
    .card-body { padding: 1rem; }
    .input { padding-top: 0.4rem; padding-bottom: 0.4rem; }
    <% } %>

    /* Card style overrides */
    .card {
      background-color: var(--card-bg);
      border: var(--app-card-border);
      box-shadow: var(--app-card-shadow);
      border-radius: var(--app-radius);
    }

    /* Sidebar width override from settings */
    <% if (sidebarW !== 'default') { %>
    .sidebar { width: <%= sbWidth %> !important; }
    <% if (sidebarW === 'wide') { %>
    body.sidebar-open .lg\:pl-64 { padding-left: <%= sbWidth %> !important; }
    <% } else if (sidebarW === 'compact') { %>
    body.sidebar-open .lg\:pl-64 { padding-left: <%= sbWidth %> !important; }
    <% } %>
    <% } %>

    /* Sidebar position override (RTL) */
    <% if (sidebarPos === 'right') { %>
    .sidebar { left: auto !important; right: 0 !important; }
    body.sidebar-open .lg\:pl-64 { padding-left: 0 !important; padding-right: <%= sbWidth %> !important; }
    <% } %>

    /* Sidebar color override */
    .sidebar { background-color: var(--sidebar-bg) !important; }
  </style>
  <script>
    // Apply theme before paint to avoid flash
    (function () {
      try {
        var t = '<%= theme %>';
        var stored = localStorage.getItem('hrm-theme') || t || 'system';
        var isDark = stored === 'dark' || (stored === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
      } catch (e) {}

      // Restore sidebar state before paint to avoid layout flash.
      try {
        var raw = localStorage.getItem('hrm-sidebar');
        var s = raw ? JSON.parse(raw) : null;
        var desktopCollapsed = s && s.desktop === 'collapsed';
        var isDesktop = window.innerWidth >= 1024;
        if (isDesktop && desktopCollapsed) {
          document.body.classList.add('sidebar-collapsed');
        } else if (isDesktop) {
          document.body.classList.add('sidebar-open');
        } else {
          document.body.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950">
  <script>
    // Expose company settings for the print utility
    window.HRM_SETTINGS = {
      companyName: '<%= (typeof companyName !== "undefined" && companyName) || "HRM System" %>',
      currencySymbol: '<%= (typeof currencySymbol !== "undefined" && currencySymbol) || "" %>',
      currency: '<%= (typeof currency !== "undefined" && currency) || "AFN" %>'
    };
  </script>
  <%- body %>

  <!-- Command Palette -->
  <div id="cmdk-overlay" class="cmdk-overlay" aria-hidden="true">
    <div class="cmdk-panel" role="dialog" aria-label="Command palette">
      <div class="cmdk-input-wrap">
        <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
        <input type="text" id="cmdk-input" class="cmdk-input" placeholder="Search pages or type a command..." autocomplete="off" />
        <kbd class="cmdk-kbd">esc</kbd>
      </div>
      <div id="cmdk-results" class="cmdk-results"></div>
      <div class="cmdk-footer">
        <span class="flex items-center gap-1.5"><kbd class="cmdk-kbd">↑</kbd><kbd class="cmdk-kbd">↓</kbd> navigate</span>
        <span class="flex items-center gap-1.5"><kbd class="cmdk-kbd">↵</kbd> select</span>
        <span class="ml-auto flex items-center gap-1.5"><kbd class="cmdk-kbd">esc</kbd> close</span>
      </div>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/print.js"></script>
  <% if (typeof pageScripts !== 'undefined') { %><%- pageScripts %><% } %>
</body>
</html>
