
<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/dashboard" class="hover:text-brand-600">Dashboard</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-slate-700 dark:text-slate-300 font-medium">User Management</span>
        </div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">User Management</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400"><%= users.length %> users total</p>
      </div>
      <div class="flex gap-2 no-print">
        <button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
        <a href="/users/create" class="btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Add User</a>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <% if (users.length) { %>
          <table class="table-clean">
            <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last Login</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
              <% users.forEach(function(u) { %>
                <tr>
                  <td>
                    <div class="flex items-center gap-2.5">
                      <% if (u.avatar) { %>
                        <img src="<%= u.avatar %>" class="w-8 h-8 rounded-full object-cover ring-2 ring-slate-100 dark:ring-slate-800" alt="Avatar" />
                      <% } else { %>
                        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 text-white flex items-center justify-center text-xs font-semibold uppercase"><%= (u.name || '?').charAt(0) %></div>
                      <% } %>
                      <span class="font-medium text-slate-800 dark:text-slate-100"><%= u.name %></span>
                    </div>
                  </td>
                  <td class="text-sm text-slate-500"><%= u.email %></td>
                  <td><span class="<%= u.role==='admin'?'badge-danger':u.role==='hr'?'badge-info':u.role==='manager'?'badge-warning':'badge-muted' %> capitalize"><%= u.role %></span></td>
                  <td><span class="<%= u.status==='active'?'badge-success':u.status==='locked'?'badge-danger':'badge-muted' %> capitalize"><%= u.status %></span></td>
                  <td class="text-sm text-slate-500"><%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString() : '—' %></td>
                  <td class="text-right">
                    <a href="/users/<%= u._id %>/edit" class="btn-icon btn-ghost btn-sm" title="Edit"><i class="fa-solid fa-pen"></i></a>
                    <% if (String(u._id) !== String(user._id)) { %>
                      <button class="btn-icon btn-ghost btn-sm text-rose-600" data-confirm="Delete user '<%= u.email %>'?" data-confirm-action="/users/<%= u._id %>?_method=DELETE" data-confirm-method="POST" title="Delete"><i class="fa-solid fa-trash"></i></button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-20">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i class="fa-solid fa-user-slash text-2xl text-slate-400"></i>
            </div>
            <h3 class="font-semibold text-slate-700 dark:text-slate-300">No users found</h3>
            <p class="text-sm text-slate-400 mt-1 mb-4">Add a user to get started.</p>
            <a href="/users/create" class="btn-primary btn-sm inline-flex"><i class="fa-solid fa-plus"></i> Add User</a>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<%- include('../partials/confirm-modal') %>
