
<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-3xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2">
      <a href="/users" class="hover:text-brand-600">User Management</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300"><%= isEdit ? 'Edit' : 'Add' %></span>
    </nav>

    <form action="<%= isEdit ? '/users/' + user._id + '?_method=PUT' : '/users' %>" method="post" class="space-y-5">
      <div class="card">
        <div class="card-body">
          <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-4"><i class="fa-solid fa-user-shield mr-2 text-brand-600"></i>Account Details</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div><label class="label">Name *</label><input name="name" value="<%= user.name || '' %>" class="input" required /></div>
            <div><label class="label">Email *</label><input type="email" name="email" value="<%= user.email || '' %>" class="input" required /></div>
            <div><label class="label">Role *</label>
              <select name="role" class="input">
                <% ['admin','hr','manager','finance','payroll','employee'].forEach(function(r){ %><option value="<%= r %>" <%= user.role===r?'selected':'' %>><%= r %></option><% }) %>
              </select>
            </div>
            <div><label class="label">Status</label>
              <select name="status" class="input">
                <% ['active','inactive','locked'].forEach(function(s){ %><option value="<%= s %>" <%= user.status===s?'selected':'' %>><%= s %></option><% }) %>
              </select>
            </div>
            <% if (!isEdit) { %>
              <div class="sm:col-span-2"><label class="label">Password *</label><input type="password" name="password" class="input" required minlength="6" placeholder="Minimum 6 characters" /></div>
            <% } else { %>
              <div class="sm:col-span-2 text-xs text-slate-500 bg-slate-50 dark:bg-slate-800 rounded-lg p-3"><i class="fa-solid fa-circle-info mr-1"></i> Password cannot be changed here. Use the profile page to update your own password.</div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-2">
        <a href="/users" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary"><i class="fa-solid fa-save"></i> <%= isEdit ? 'Update' : 'Create' %> User</button>
      </div>
    </form>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
