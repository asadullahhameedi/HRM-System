<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/dashboard" class="hover:text-brand-600">Dashboard</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <a href="/payroll/periods" class="hover:text-brand-600">Payroll</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-slate-700 dark:text-slate-300 font-medium">Payslips</span>
        </div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Payslips</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400"><%= pagination.total %> total payslips</p>
      </div>
      <div class="flex gap-2 items-end no-print flex-wrap">
        <% if (['admin','hr','finance','payroll'].indexOf(user.role) !== -1) { %>
        <a href="/payroll/payslips/create" class="btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Generate Payslip</a>
        <% } %>
        <button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
        <form method="get" class="flex gap-2 items-end">
          <div><label class="label">Period</label><select name="period" class="input" onchange="this.form.submit()"><option value="">All Periods</option><% periods.forEach(function(p){ %><option value="<%= p._id %>" <%= filters.period==p._id?'selected':'' %>><%= p.name %></option><% }) %></select></div>
        </form>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <% if (payslips.length) { %>
          <table class="table-clean">
            <thead><tr><th>Payslip No</th><th>Employee</th><th>Period</th><th class="text-right">Gross</th><th class="text-right">Deductions</th><th class="text-right">Net Pay</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
              <% payslips.forEach(function(p) { %>
                <tr>
                  <td class="font-mono text-sm"><%= p.payslipNo %></td>
                  <td>
                    <div class="flex items-center gap-2.5">
                      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-xs font-semibold text-white ring-2 ring-brand-100 dark:ring-brand-900/30"><%= p.employee ? (p.employee.firstName||'?').charAt(0) + (p.employee.lastName||'').charAt(0) : '?' %></div>
                      <div><div class="font-medium text-slate-800 dark:text-slate-100"><%= p.employee ? p.employee.firstName+' '+p.employee.lastName : '—' %></div><div class="text-xs text-slate-500"><%= p.employee ? p.employee.employeeId : '' %></div></div>
                    </div>
                  </td>
                  <td class="text-sm"><%= p.period ? p.period.name : '—' %></td>
                  <td class="text-right"><%= currencySymbol %><%= Number(p.grossEarnings).toLocaleString() %></td>
                  <td class="text-right text-rose-600"><%= currencySymbol %><%= Number(p.totalDeductions).toLocaleString() %></td>
                  <td class="text-right font-semibold"><%= currencySymbol %><%= Number(p.netPay).toLocaleString() %></td>
                  <td><% var sc = { draft:'badge-muted', pending:'badge-warning', approved:'badge-info', paid:'badge-success', cancelled:'badge-danger' }[p.status]; %><span class="<%= sc %> capitalize"><%= p.status %></span></td>
                  <td class="text-right">
                    <a href="/payroll/payslips/<%= p._id %>" class="btn-icon btn-ghost btn-sm" title="View"><i class="fa-solid fa-eye"></i></a>
                    <a href="/payroll/payslips/<%= p._id %>/pdf" class="btn-icon btn-ghost btn-sm" title="Download PDF"><i class="fa-solid fa-file-pdf"></i></a>
                    <% if (['admin','hr','finance','payroll'].indexOf(user.role) !== -1) { %>
                    <% if (p.status === 'draft' || p.status === 'pending') { %>
                    <form method="post" action="/payroll/payslips/<%= p._id %>/approve" class="inline"><button type="submit" class="btn-icon btn-ghost btn-sm text-emerald-600" title="Approve"><i class="fa-solid fa-check"></i></button></form>
                    <% } %>
                    <button class="btn-icon btn-ghost btn-sm text-rose-600" title="Delete" data-confirm="Delete this payslip?" data-confirm-action="/payroll/payslips/<%= p._id %>?_method=DELETE" data-confirm-method="POST"><i class="fa-solid fa-trash"></i></button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-20">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i class="fa-solid fa-file-invoice-dollar text-2xl text-slate-400"></i>
            </div>
            <h3 class="font-semibold text-slate-700 dark:text-slate-300">No payslips found</h3>
            <p class="text-sm text-slate-400 mt-1">Generate a payslip or select a different period.</p>
          </div>
        <% } %>
      </div>
    </div>

    <%- include('../partials/pagination', { pagination, query: filters }) %>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<%- include('../partials/confirm-modal') %>
