<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5">
    <div class="flex items-center justify-between">
      <div><h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Salary</h2><p class="text-sm text-slate-500"><%= pagination.total %> records</p></div>
      <div class="flex gap-2 no-print">
        <button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
        <% if (['admin','hr','finance'].indexOf(user.role) !== -1) { %><a href="/payroll/structures/create" class="btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Add Salary</a><% } %>
      </div>
    </div>

    <div class="card">
      <div class="overflow-x-auto">
        <% if (structures.length) { %>
          <table class="table-clean">
            <thead><tr><th>Employee</th><th class="text-right">Basic Salary</th><th class="text-right">Allowances</th><th class="text-right">Deductions</th><th class="text-right">Tax</th><th>Overtime</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
              <% structures.forEach(function(s) { %>
                <% var allowanceTotal = s.allowances.reduce((a,c) => a + (c.amount||0), 0); %>
                <% var deductionTotal = s.deductions.reduce((a,c) => a + (c.amount||0), 0); %>
                <tr>
                  <td>
                    <div class="flex items-center gap-2">
                      <div class="w-8 h-8 rounded-full bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center text-xs font-semibold text-brand-600"><%= s.employee ? (s.employee.firstName||'?').charAt(0) + (s.employee.lastName||'').charAt(0) : '?' %></div>
                      <div><div class="font-medium"><%= s.employee ? s.employee.firstName+' '+s.employee.lastName : '—' %></div><div class="text-xs text-slate-500"><%= s.employee ? s.employee.employeeId : '' %></div></div>
                    </div>
                  </td>
                  <td class="text-right font-medium"><%= currencySymbol %><%= Number(s.basicSalary).toLocaleString() %></td>
                  <td class="text-right text-sm text-emerald-600"><%= currencySymbol %><%= Number(allowanceTotal).toLocaleString() %></td>
                  <td class="text-right text-sm text-rose-600"><%= currencySymbol %><%= Number(deductionTotal).toLocaleString() %></td>
                  <td class="text-right"><%= s.taxPercent %>%</td>
                  <td><%- s.overtimeEnabled ? '<span class="badge-success">On</span>' : '<span class="badge-muted">Off</span>' %></td>
                  <td><span class="<%= s.status==='active'?'badge-success':'badge-muted' %> capitalize"><%= s.status %></span></td>
                  <td class="text-right">
                    <a href="/payroll/structures/<%= s._id %>/edit" class="btn-icon btn-ghost btn-sm" title="Edit"><i class="fa-solid fa-pen"></i></a>
                    <% if (user.role === 'admin') { %><button class="btn-icon btn-ghost btn-sm text-rose-600" title="Delete" data-confirm="Delete this salary record?" data-confirm-action="/payroll/structures/<%= s._id %>?_method=DELETE" data-confirm-method="POST"><i class="fa-solid fa-trash"></i></button><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-16"><i class="fa-solid fa-sliders text-4xl text-slate-300 mb-3 block"></i><h3 class="font-medium text-slate-600 dark:text-slate-300">No salary records</h3><p class="text-sm text-slate-400 mt-1">Add a salary record before running payroll.</p></div>
        <% } %>
      </div>
    </div>

    <%- include('../partials/pagination', { pagination, query: filters }) %>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<%- include('../partials/confirm-modal') %>
