
<% var sym = currencySymbol; %>
<% var emp = payslip.employee || {};
   var period = payslip.period || {};
   var settings = (typeof settingsMap !== 'undefined' && settingsMap.general) || {};
%>

<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-5xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print">
      <a href="/payroll/payslips" class="hover:text-brand-600">Payslips</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300"><%= payslip.payslipNo %></span>
    </nav>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 no-print">
      <div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Payslip <%= payslip.payslipNo %></h2>
        <p class="text-sm text-slate-500"><%= period.name || '' %> · <span class="capitalize"><%= payslip.status %></span></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
        <a href="/payroll/payslips/<%= payslip._id %>/pdf" class="btn-secondary btn-sm"><i class="fa-solid fa-file-pdf"></i> PDF</a>
        <% if (['admin','hr','finance'].indexOf(user.role) !== -1) { %>
          <a href="/payroll/payslips/create?employee=<%= emp._id || emp %>&period=<%= period._id %>" class="btn-secondary btn-sm" title="Regenerate from latest attendance"><i class="fa-solid fa-arrows-rotate"></i> Regenerate</a>
          <% if (['draft','pending'].indexOf(payslip.status) !== -1) { %>
            <form method="post" action="/payroll/payslips/<%= payslip._id %>/approve" class="inline"><button class="btn-primary btn-sm"><i class="fa-solid fa-check"></i> Approve</button></form>
          <% } %>
          <% if (['draft','pending','approved'].indexOf(payslip.status) !== -1) { %>
            <button class="btn-secondary btn-sm" data-modal-open="adjust-modal"><i class="fa-solid fa-sliders"></i> Adjust</button>
          <% } %>
          <button class="btn-danger btn-sm" data-confirm="Delete this payslip?" data-confirm-action="/payroll/payslips/<%= payslip._id %>?_method=DELETE" data-confirm-method="POST"><i class="fa-solid fa-trash"></i> Delete</button>
        <% } %>
      </div>
    </div>

    <!-- ============ Modern Payslip Document ============ -->
    <div id="payslip-doc" class="bg-white dark:bg-slate-900 rounded-xl shadow-lg overflow-hidden border border-slate-200 dark:border-slate-700">

      <!-- Header band -->
      <div class="bg-gradient-to-r from-brand-600 to-brand-700 text-white p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 payslip-header">
        <div class="flex items-center gap-4">
          <% if (settings.companyLogo) { %>
            <img src="<%= settings.companyLogo %>" alt="Logo" class="w-14 h-14 rounded-xl bg-white/20 p-1.5 object-contain" />
          <% } else { %>
            <div class="w-14 h-14 rounded-xl bg-white/20 flex items-center justify-center">
              <i class="fa-solid fa-building text-2xl"></i>
            </div>
          <% } %>
          <div>
            <h1 class="text-xl font-bold"><%= settings.companyName || companyName || 'HRM System' %></h1>
            <p class="text-xs opacity-80"><%= settings.address || companyAddress || '' %></p>
            <p class="text-xs opacity-80">
              <% if (settings.companyEmail) { %><i class="fa-solid fa-envelope mr-1"></i><%= settings.companyEmail %><% } %>
              <% if (settings.companyPhone) { %> · <i class="fa-solid fa-phone mr-1"></i><%= settings.companyPhone %><% } %>
            </p>
          </div>
        </div>
        <div class="text-right">
          <div class="text-xs uppercase tracking-wider opacity-80">Payslip</div>
          <div class="text-2xl font-extrabold"><%= payslip.payslipNo %></div>
          <div class="text-xs opacity-80 mt-1"><%= period.name || '' %></div>
          <div class="mt-2">
            <% var stCls = { draft:'bg-white/20', pending:'bg-amber-400 text-amber-900', approved:'bg-sky-400 text-sky-900', paid:'bg-emerald-400 text-emerald-900', cancelled:'bg-rose-400 text-rose-900' }[payslip.status]; %>
            <span class="<%= stCls %> px-2 py-0.5 rounded-full text-xs font-semibold uppercase"><%= payslip.status %></span>
          </div>
        </div>
      </div>

      <!-- Employee + Bank info -->
      <div class="p-6 border-b border-slate-200 dark:border-slate-700">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <!-- Employee photo + name -->
          <div class="flex items-center gap-4">
            <% if (emp.avatar) { %>
              <img src="<%= emp.avatar %>" class="w-16 h-16 rounded-2xl object-cover border-2 border-brand-100" alt="Avatar" />
            <% } else { %>
              <div class="w-16 h-16 rounded-2xl bg-brand-600 text-white flex items-center justify-center text-xl font-bold uppercase"><%= (emp.firstName || '?').charAt(0) %><%= (emp.lastName || '').charAt(0) %></div>
            <% } %>
            <div>
              <h3 class="font-bold text-slate-800 dark:text-slate-100 text-lg"><%= emp.fullName || (emp.firstName + ' ' + emp.lastName) %></h3>
              <div class="text-xs text-slate-500"><%= emp.designation ? emp.designation.name : '' %></div>
              <div class="text-xs text-slate-500"><%= emp.department ? emp.department.name : '' %></div>
            </div>
          </div>
          <!-- Employee details -->
          <div class="text-sm space-y-1.5">
            <div class="flex justify-between"><span class="text-slate-500">Employee #</span><span class="font-medium"><%= emp.employeeId || '—' %></span></div>
            <div class="flex justify-between"><span class="text-slate-500">Tax Number</span><span class="font-medium"><%= emp.taxNumber || settings.taxNumber || '—' %></span></div>
            <div class="flex justify-between"><span class="text-slate-500">Email</span><span class="font-medium text-xs"><%= emp.email || '—' %></span></div>
            <div class="flex justify-between"><span class="text-slate-500">Phone</span><span class="font-medium text-xs"><%= emp.phone || '—' %></span></div>
          </div>
          <!-- Bank info -->
          <div class="text-sm space-y-1.5">
            <div class="flex justify-between"><span class="text-slate-500">Bank Name</span><span class="font-medium"><%= emp.bankName || '—' %></span></div>
            <div class="flex justify-between"><span class="text-slate-500">Account #</span><span class="font-medium font-mono text-xs"><%= emp.bankAccount || '—' %></span></div>
            <div class="flex justify-between"><span class="text-slate-500">Payment Method</span><span class="font-medium capitalize"><%= payslip.paymentMethod || 'Bank Transfer' %></span></div>
            <div class="flex justify-between"><span class="text-slate-500">Payment Date</span><span class="font-medium"><%= payslip.paidAt ? new Date(payslip.paidAt).toLocaleDateString() : (period.paymentDate ? new Date(period.paymentDate).toLocaleDateString() : '—') %></span></div>
          </div>
        </div>
      </div>

      <!-- Attendance + Overtime + Leave summary -->
      <div class="p-6 border-b border-slate-200 dark:border-slate-700">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Attendance Summary</h4>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3">
          <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
            <div class="text-xs text-slate-500">Working Days</div>
            <div class="text-lg font-bold text-slate-800 dark:text-slate-100"><%= (payslip.attendance.presentDays || 0) + (payslip.attendance.absentDays || 0) + (payslip.attendance.paidLeaveDays || 0) + (payslip.attendance.holidays || 0) %></div>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
            <div class="text-xs text-slate-500">Present</div>
            <div class="text-lg font-bold text-emerald-600"><%= payslip.attendance.presentDays || 0 %></div>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
            <div class="text-xs text-slate-500">Absent</div>
            <div class="text-lg font-bold text-rose-600"><%= payslip.attendance.absentDays || 0 %></div>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
            <div class="text-xs text-slate-500">Paid Leave</div>
            <div class="text-lg font-bold text-sky-600"><%= payslip.attendance.paidLeaveDays || 0 %></div>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
            <div class="text-xs text-slate-500">Holidays</div>
            <div class="text-lg font-bold text-amber-600"><%= payslip.attendance.holidays || 0 %></div>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
            <div class="text-xs text-slate-500">Overtime (hrs)</div>
            <div class="text-lg font-bold text-brand-600"><%= payslip.overtime.hours || 0 %></div>
          </div>
        </div>
      </div>

      <!-- Earnings + Deductions -->
      <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Earnings -->
        <div>
          <h4 class="font-semibold text-emerald-600 mb-3 flex items-center gap-2"><i class="fa-solid fa-arrow-trend-up"></i> Earnings</h4>
          <table class="w-full text-sm">
            <tbody>
              <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300">Basic Salary</td><td class="py-2 text-right font-medium"><%= sym %><%= Number(payslip.basicSalary).toLocaleString() %></td></tr>
              <% payslip.allowances.forEach(function(a){ %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300"><%= a.name %></td><td class="py-2 text-right font-medium"><%= sym %><%= Number(a.amount).toLocaleString() %></td></tr>
              <% }) %>
              <% if (payslip.overtime.amount) { %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300">Overtime (<%= payslip.overtime.hours %> hrs)</td><td class="py-2 text-right font-medium"><%= sym %><%= Number(payslip.overtime.amount).toLocaleString() %></td></tr>
              <% } %>
              <% payslip.bonuses.forEach(function(a){ %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300"><%= a.name %></td><td class="py-2 text-right font-medium"><%= sym %><%= Number(a.amount).toLocaleString() %></td></tr>
              <% }) %>
              <% payslip.incentives.forEach(function(a){ %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300"><%= a.name %></td><td class="py-2 text-right font-medium"><%= sym %><%= Number(a.amount).toLocaleString() %></td></tr>
              <% }) %>
              <% if (payslip.manualAdjustments.add) { %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300">Manual Addition</td><td class="py-2 text-right font-medium"><%= sym %><%= Number(payslip.manualAdjustments.add).toLocaleString() %></td></tr>
              <% } %>
              <tr class="bg-emerald-50 dark:bg-emerald-900/20">
                <td class="py-3 px-2 font-semibold text-emerald-700 dark:text-emerald-300">Gross Earnings</td>
                <td class="py-3 px-2 text-right font-bold text-emerald-700 dark:text-emerald-300"><%= sym %><%= Number(payslip.grossEarnings).toLocaleString() %></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Deductions -->
        <div>
          <h4 class="font-semibold text-rose-600 mb-3 flex items-center gap-2"><i class="fa-solid fa-arrow-trend-down"></i> Deductions</h4>
          <table class="w-full text-sm">
            <tbody>
              <% payslip.deductions.forEach(function(a){ %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300"><%= a.name %></td><td class="py-2 text-right font-medium"><%= sym %><%= Number(a.amount).toLocaleString() %></td></tr>
              <% }) %>
              <% if (payslip.tax.amount) { %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300">Tax (<%= payslip.tax.percent %>%)</td><td class="py-2 text-right font-medium"><%= sym %><%= Number(payslip.tax.amount).toLocaleString() %></td></tr>
              <% } %>
              <% if (payslip.absentPenalty.amount) { %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300">Absent Penalty (<%= payslip.absentPenalty.days %> days)</td><td class="py-2 text-right font-medium"><%= sym %><%= Number(payslip.absentPenalty.amount).toLocaleString() %></td></tr>
              <% } %>
              <% if (payslip.loanInstallment) { %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300">Loan Installment</td><td class="py-2 text-right font-medium"><%= sym %><%= Number(payslip.loanInstallment).toLocaleString() %></td></tr>
              <% } %>
              <% if (payslip.advance) { %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300">Salary Advance</td><td class="py-2 text-right font-medium"><%= sym %><%= Number(payslip.advance).toLocaleString() %></td></tr>
              <% } %>
              <% if (payslip.manualAdjustments.deduct) { %>
                <tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2 text-slate-600 dark:text-slate-300">Manual Deduction</td><td class="py-2 text-right font-medium"><%= sym %><%= Number(payslip.manualAdjustments.deduct).toLocaleString() %></td></tr>
              <% } %>
              <tr class="bg-rose-50 dark:bg-rose-900/20">
                <td class="py-3 px-2 font-semibold text-rose-700 dark:text-rose-300">Total Deductions</td>
                <td class="py-3 px-2 text-right font-bold text-rose-700 dark:text-rose-300"><%= sym %><%= Number(payslip.totalDeductions).toLocaleString() %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Net pay band -->
      <div class="bg-gradient-to-r from-slate-800 to-slate-900 text-white p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs uppercase tracking-wider opacity-70">Net Salary</div>
          <div class="text-3xl font-extrabold mt-1"><%= sym %><%= Number(payslip.netPay).toLocaleString() %></div>
        </div>
        <div class="text-right text-sm opacity-80">
          <% if (payslip.paidAt) { %>
            <div><i class="fa-solid fa-circle-check mr-1"></i> Paid on <%= new Date(payslip.paidAt).toLocaleDateString() %></div>
          <% } else { %>
            <div><i class="fa-solid fa-clock mr-1"></i> Awaiting payment</div>
          <% } %>
          <div class="text-xs mt-1"><%= period.name || '' %></div>
        </div>
      </div>

      <!-- Notes / signature -->
      <% if (payslip.notes) { %>
      <div class="p-6 border-t border-slate-200 dark:border-slate-700">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Narration</h4>
        <p class="text-sm text-slate-600 dark:text-slate-300"><%= payslip.notes %></p>
      </div>
      <% } %>

      <div class="p-6 flex flex-col sm:flex-row items-end justify-between gap-4 text-xs text-slate-400">
        <div>
          <p>This is a system-generated payslip and does not require a physical signature.</p>
          <p class="mt-1">Generated on <%= new Date(payslip.createdAt || Date.now()).toLocaleString() %></p>
        </div>
        <% if ((typeof settingsMap !== 'undefined' && settingsMap.payroll && settingsMap.payroll.payslipShowSignature !== false) || !settingsMap.payroll) { %>
        <div class="text-center">
          <div class="border-t border-slate-300 dark:border-slate-600 w-40 pt-1 mt-8">Authorized Signature</div>
        </div>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>

<!-- Adjust modal -->
<div id="adjust-modal" class="no-print hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/50" data-modal-close></div>
  <div class="relative bg-white dark:bg-slate-900 rounded-xl shadow-xl w-full max-w-lg p-6 max-h-[90vh] overflow-y-auto">
    <h3 class="text-lg font-semibold mb-4">Adjust Payslip</h3>
    <form method="post" action="/payroll/payslips/<%= payslip._id %>/adjust" class="grid grid-cols-2 gap-3">
      <div><label class="label">Manual Add</label><input type="number" step="0.01" name="manualAdd" value="<%= payslip.manualAdjustments.add %>" class="input" /></div>
      <div><label class="label">Manual Deduct</label><input type="number" step="0.01" name="manualDeduct" value="<%= payslip.manualAdjustments.deduct %>" class="input" /></div>
      <div><label class="label">Overtime Hours</label><input type="number" step="0.5" name="overtimeHours" value="<%= payslip.overtime.hours %>" class="input" /></div>
      <div><label class="label">Loan Installment</label><input type="number" step="0.01" name="loanInstallment" value="<%= payslip.loanInstallment %>" class="input" /></div>
      <div><label class="label">Advance</label><input type="number" step="0.01" name="advance" value="<%= payslip.advance %>" class="input" /></div>
      <div class="col-span-2"><label class="label">Notes</label><textarea name="notes" class="input" rows="2"><%= payslip.notes || '' %></textarea></div>
      <div class="col-span-2 flex justify-end gap-2 pt-2"><button type="button" class="btn-secondary" data-modal-close>Cancel</button><button class="btn-primary">Save Adjustments</button></div>
    </form>
  </div>
</div>

<style>
/* Print-specific styles — strips out the app chrome and prints just the
   payslip document on a clean A4 page. */
@media print {
  body * { visibility: hidden; }
  #payslip-doc, #payslip-doc * { visibility: visible; }
  #payslip-doc { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none; border: none; }
  .no-print, .no-print * { display: none !important; }
  .payslip-header { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
</style>
