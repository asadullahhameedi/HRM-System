
<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-5xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2"><a href="/payroll/structures" class="hover:text-brand-600">Salary Structures</a><i class="fa-solid fa-chevron-right text-xs"></i><span class="text-slate-700 dark:text-slate-300"><%= isEdit ? 'Edit' : 'Add' %></span></nav>

    <form action="<%= isEdit ? '/payroll/structures/' + structure._id + '?_method=PUT' : '/payroll/structures' %>" method="post" class="space-y-5">
      <div class="card">
        <div class="card-body">
          <h3 class="font-semibold mb-4"><i class="fa-solid fa-user-tie mr-2 text-brand-600"></i>Employee & Basic</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div><label class="label">Employee *</label>
              <select name="employee" class="input" required <%= isEdit ? 'disabled' : '' %>>
                <option value="">Select</option>
                <% employees.forEach(function(e){ %><option value="<%= e._id %>" <%= (!isEdit && typeof query !== 'undefined' && query && query.employee==e._id) || (isEdit && structure.employee && (structure.employee._id||structure.employee)==e._id) ? 'selected':'' %>><%= e.employeeId %> · <%= e.firstName %> <%= e.lastName %></option><% }) %>
              </select>
              <% if (isEdit) { %><input type="hidden" name="employee" value="<%= structure.employee && (structure.employee._id||structure.employee) %>" /><% } %>
            </div>
            <div><label class="label">Basic Salary *</label><input type="number" step="0.01" name="basicSalary" value="<%= structure.basicSalary || 0 %>" class="input" required /></div>
            <div><label class="label">Tax Percent (%)</label><input type="number" step="0.01" name="taxPercent" value="<%= structure.taxPercent || 0 %>" class="input" /></div>
            <div><label class="label">Effective From</label><input type="date" name="effectiveFrom" value="<%= structure.effectiveFrom ? new Date(structure.effectiveFrom).toISOString().slice(0,10) : '' %>" class="input" /></div>
            <div class="flex items-center gap-2 pt-6"><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="overtimeEnabled" <%= structure.overtimeEnabled !== false ? 'checked' : '' %> class="rounded border-slate-300 text-brand-600" /> Enable Overtime</label></div>
          </div>
        </div>
      </div>

      <!-- Component repeaters -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <div class="card">
          <div class="card-body">
            <div class="flex items-center justify-between mb-3"><h3 class="font-semibold text-emerald-600"><i class="fa-solid fa-plus-circle mr-2"></i>Allowances</h3><button type="button" class="btn-ghost btn-sm" data-add-row="allowances"><i class="fa-solid fa-plus"></i></button></div>
            <div id="allowances-container" class="space-y-2">
              <% (structure.allowances || []).forEach(function(a){ %>
                <div class="flex gap-2"><input name="allowances_name" value="<%= a.name %>" class="input flex-1" placeholder="Name" /><input name="allowances_amount" type="number" step="0.01" value="<%= a.amount %>" class="input w-32" placeholder="Amount" /><button type="button" class="btn-icon btn-ghost text-rose-600" data-remove-row><i class="fa-solid fa-xmark"></i></button></div>
              <% }) %>
            </div>
            <p class="help-text">Transport, housing, food, etc.</p>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="flex items-center justify-between mb-3"><h3 class="font-semibold text-amber-600"><i class="fa-solid fa-gift mr-2"></i>Bonuses</h3><button type="button" class="btn-ghost btn-sm" data-add-row="bonuses"><i class="fa-solid fa-plus"></i></button></div>
            <div id="bonuses-container" class="space-y-2">
              <% (structure.bonuses || []).forEach(function(a){ %>
                <div class="flex gap-2"><input name="bonuses_name" value="<%= a.name %>" class="input flex-1" placeholder="Name" /><input name="bonuses_amount" type="number" step="0.01" value="<%= a.amount %>" class="input w-32" placeholder="Amount" /><button type="button" class="btn-icon btn-ghost text-rose-600" data-remove-row><i class="fa-solid fa-xmark"></i></button></div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="flex items-center justify-between mb-3"><h3 class="font-semibold text-sky-600"><i class="fa-solid fa-star mr-2"></i>Incentives</h3><button type="button" class="btn-ghost btn-sm" data-add-row="incentives"><i class="fa-solid fa-plus"></i></button></div>
            <div id="incentives-container" class="space-y-2">
              <% (structure.incentives || []).forEach(function(a){ %>
                <div class="flex gap-2"><input name="incentives_name" value="<%= a.name %>" class="input flex-1" placeholder="Name" /><input name="incentives_amount" type="number" step="0.01" value="<%= a.amount %>" class="input w-32" placeholder="Amount" /><button type="button" class="btn-icon btn-ghost text-rose-600" data-remove-row><i class="fa-solid fa-xmark"></i></button></div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="flex items-center justify-between mb-3"><h3 class="font-semibold text-rose-600"><i class="fa-solid fa-minus-circle mr-2"></i>Deductions</h3><button type="button" class="btn-ghost btn-sm" data-add-row="deductions"><i class="fa-solid fa-plus"></i></button></div>
            <div id="deductions-container" class="space-y-2">
              <% (structure.deductions || []).forEach(function(a){ %>
                <div class="flex gap-2"><input name="deductions_name" value="<%= a.name %>" class="input flex-1" placeholder="Name" /><input name="deductions_amount" type="number" step="0.01" value="<%= a.amount %>" class="input w-32" placeholder="Amount" /><button type="button" class="btn-icon btn-ghost text-rose-600" data-remove-row><i class="fa-solid fa-xmark"></i></button></div>
              <% }) %>
            </div>
            <p class="help-text">Insurance, provident fund, etc.</p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-body"><label class="label">Notes</label><textarea name="notes" class="input" rows="2"><%= structure.notes || '' %></textarea></div>
      </div>

      <div class="flex justify-end gap-2"><a href="/payroll/structures" class="btn-secondary">Cancel</a><button class="btn-primary"><i class="fa-solid fa-save"></i> Save Structure</button></div>
    </form>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>

<template id="row-template"><div class="flex gap-2"><input name="" class="input flex-1" placeholder="Name" /><input name="" type="number" step="0.01" class="input w-32" placeholder="Amount" /><button type="button" class="btn-icon btn-ghost text-rose-600" data-remove-row><i class="fa-solid fa-xmark"></i></button></div></template>
