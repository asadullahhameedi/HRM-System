
<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/dashboard" class="hover:text-brand-600">Dashboard</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-slate-700 dark:text-slate-300 font-medium">Employees</span>
        </div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Employees</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400"><%= pagination.total %> total · <%= employees.length %> showing</p>
      </div>
      <div class="flex gap-2 no-print">
        <a href="/employees/export/excel" class="btn-secondary btn-sm"><i class="fa-solid fa-file-excel"></i> Export</a>
        <button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
        <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
          <a href="/employees/create" class="btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Add Employee</a>
        <% } %>
      </div>
    </div>

    <!-- Filters -->
    <form method="get" class="card p-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <div class="lg:col-span-2">
          <label class="label">Search</label>
          <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
            <input type="text" name="search" value="<%= filters.search || '' %>" class="input pl-10" placeholder="ID, name, email..." />
          </div>
        </div>
        <div>
          <label class="label">Department</label>
          <select name="department" class="input">
            <option value="">All Departments</option>
            <% departments.forEach(function(d) { %>
              <option value="<%= d._id %>" <%= filters.department == d._id ? 'selected' : '' %>><%= d.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="label">Status</label>
          <select name="status" class="input">
            <option value="">All Statuses</option>
            <% ['active','inactive','terminated','resigned'].forEach(function(s) { %>
              <option value="<%= s %>" <%= filters.status == s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <div class="flex items-end gap-2">
          <button type="submit" class="btn-primary flex-1"><i class="fa-solid fa-filter"></i> Filter</button>
          <a href="/employees" class="btn-secondary" title="Reset filters"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
      </div>
    </form>

    <!-- Table -->
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <% if (employees.length) { %>
          <table class="table-clean">
            <thead>
              <tr>
                <th>Employee</th><th>Department</th><th>Designation</th><th>Type</th><th>Status</th><th>Joined</th><th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% employees.forEach(function(e) { %>
                <tr>
                  <td>
                    <div class="flex items-center gap-3">
                      <% if (e.avatar) { %>
                        <img src="<%= e.avatar %>" class="w-9 h-9 rounded-full object-cover ring-2 ring-slate-100 dark:ring-slate-800" alt="Avatar" />
                      <% } else { %>
                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 text-white flex items-center justify-center text-xs font-semibold uppercase ring-2 ring-brand-100 dark:ring-brand-900/30"><%= (e.firstName || '?').charAt(0) %><%= (e.lastName || '').charAt(0) %></div>
                      <% } %>
                      <div>
                        <a href="/employees/<%= e._id %>" class="font-medium text-slate-800 dark:text-slate-100 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"><%= e.firstName %> <%= e.lastName %></a>
                        <div class="text-xs text-slate-500 flex items-center gap-1.5">
                          <span><%= e.employeeId %></span>
                          <span class="text-slate-300">·</span>
                          <span class="truncate max-w-[180px]"><%= e.email %></span>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td><%= e.department ? e.department.name : '<span class="text-slate-400">—</span>' %></td>
                  <td><%= e.designation ? e.designation.name : '<span class="text-slate-400">—</span>' %></td>
                  <td><span class="badge-muted capitalize"><%= e.employmentType %></span></td>
                  <td>
                    <% var sc = { active:'badge-success', inactive:'badge-muted', terminated:'badge-danger', resigned:'badge-warning' }[e.status]; %>
                    <span class="<%= sc %> capitalize">
                      <span class="status-dot bg-current opacity-60"></span>
                      <%= e.status %>
                    </span>
                  </td>
                  <td class="text-slate-500 text-sm"><%= e.joinDate ? new Date(e.joinDate).toLocaleDateString() : '—' %></td>
                  <td class="text-right">
                    <div class="inline-flex items-center gap-1">
                      <a href="/employees/<%= e._id %>" class="btn-icon btn-ghost btn-sm" title="View"><i class="fa-solid fa-eye"></i></a>
                      <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
                        <a href="/employees/<%= e._id %>/edit" class="btn-icon btn-ghost btn-sm" title="Edit"><i class="fa-solid fa-pen"></i></a>
                      <% } %>
                      <% if (user.role === 'admin') { %>
                        <button class="btn-icon btn-ghost btn-sm text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-900/20" data-confirm="Delete employee <%= e.firstName %> <%= e.lastName %>?" data-confirm-action="/employees/<%= e._id %>?_method=DELETE" data-confirm-method="POST" title="Delete"><i class="fa-solid fa-trash"></i></button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-20">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i class="fa-solid fa-users-slash text-2xl text-slate-400"></i>
            </div>
            <h3 class="font-semibold text-slate-700 dark:text-slate-300">No employees found</h3>
            <p class="text-sm text-slate-400 mt-1 mb-4">Try adjusting your filters or add a new employee.</p>
            <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
              <a href="/employees/create" class="btn-primary btn-sm inline-flex"><i class="fa-solid fa-plus"></i> Add Employee</a>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>

    <%- include('../partials/pagination', { pagination, query: filters }) %>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<%- include('../partials/confirm-modal') %>
