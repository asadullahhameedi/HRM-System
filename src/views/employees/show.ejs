
<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 flex items-center gap-2">
      <a href="/employees" class="hover:text-brand-600">Employees</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300"><%= employee.fullName %></span>
    </nav>

    <!-- Header card -->
    <div class="card">
      <div class="card-body flex flex-col sm:flex-row items-start sm:items-center gap-5">
        <% if (employee.avatar) { %>
          <img src="<%= employee.avatar %>" class="w-20 h-20 rounded-2xl object-cover" alt="Avatar" />
        <% } else { %>
          <div class="w-20 h-20 rounded-2xl bg-brand-600 text-white flex items-center justify-center text-2xl font-bold uppercase">
            <%= (employee.firstName || '?').charAt(0) %><%= (employee.lastName || '').charAt(0) %>
          </div>
        <% } %>
        <div class="flex-1">
          <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100"><%= employee.fullName %></h2>
          <div class="text-sm text-slate-500 mt-0.5"><%= employee.designation ? employee.designation.name : 'No designation' %> · <%= employee.department ? employee.department.name : 'No department' %></div>
          <div class="flex flex-wrap gap-2 mt-2">
            <span class="badge-muted"><%= employee.employeeId %></span>
            <span class="badge-info capitalize"><%= employee.employmentType %></span>
            <% var sc = { active:'badge-success', inactive:'badge-muted', terminated:'badge-danger', resigned:'badge-warning' }[employee.status]; %>
            <span class="<%= sc %> capitalize"><%= employee.status %></span>
          </div>
        </div>
        <div class="flex gap-2">
          <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
            <a href="/employees/<%= employee._id %>/edit" class="btn-secondary btn-sm"><i class="fa-solid fa-pen"></i> Edit</a>
          <% } %>
          <a href="/employees" class="btn-ghost btn-sm"><i class="fa-solid fa-arrow-left"></i> Back</a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      <!-- Personal -->
      <div class="card">
        <div class="card-body">
          <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-3"><i class="fa-solid fa-user mr-2 text-brand-600"></i>Personal</h3>
          <dl class="space-y-2 text-sm">
            <div class="flex justify-between"><dt class="text-slate-500">Email</dt><dd class="text-slate-700 dark:text-slate-200"><%= employee.email %></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Phone</dt><dd><%= employee.phone || '—' %></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Gender</dt><dd class="capitalize"><%= employee.gender || '—' %></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">DOB</dt><dd><%= employee.dateOfBirth ? new Date(employee.dateOfBirth).toLocaleDateString() : '—' %></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Marital</dt><dd class="capitalize"><%= employee.maritalStatus || '—' %></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Nationality</dt><dd><%= employee.nationality || '—' %></dd></div>
          </dl>
        </div>
      </div>

      <!-- Employment -->
      <div class="card">
        <div class="card-body">
          <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-3"><i class="fa-solid fa-briefcase mr-2 text-brand-600"></i>Employment</h3>
          <dl class="space-y-2 text-sm">
            <div class="flex justify-between"><dt class="text-slate-500">Department</dt><dd><%= employee.department ? employee.department.name : '—' %></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Designation</dt><dd><%= employee.designation ? employee.designation.name : '—' %></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Type</dt><dd class="capitalize"><%= employee.employmentType %></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Join Date</dt><dd><%= employee.joinDate ? new Date(employee.joinDate).toLocaleDateString() : '—' %></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Exit Date</dt><dd><%= employee.exitDate ? new Date(employee.exitDate).toLocaleDateString() : '—' %></dd></div>
          </dl>
        </div>
      </div>

      <!-- Salary structure + actions -->
      <div class="card">
        <div class="card-body">
          <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-3"><i class="fa-solid fa-money-bill-wave mr-2 text-brand-600"></i>Salary</h3>
          <% if (structure) { %>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between"><dt class="text-slate-500">Basic</dt><dd class="font-medium"><%= currencySymbol %><%= structure.basicSalary.toLocaleString() %></dd></div>
              <div class="flex justify-between"><dt class="text-slate-500">Tax</dt><dd><%= structure.taxPercent %>%</dd></div>
              <div class="flex justify-between"><dt class="text-slate-500">Allowances</dt><dd><%= structure.allowances.length %></dd></div>
              <div class="flex justify-between"><dt class="text-slate-500">Overtime</dt><dd><%= structure.overtimeEnabled ? 'Enabled' : 'Disabled' %></dd></div>
            </dl>
            <a href="/payroll/structures" class="btn-secondary btn-sm w-full mt-3"><i class="fa-solid fa-sliders"></i> Manage Structure</a>
          <% } else { %>
            <div class="text-center py-6 text-sm text-slate-400">
              <i class="fa-solid fa-circle-exclamation text-2xl mb-2 block"></i>No salary structure set.
            </div>
            <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
              <a href="/payroll/structures/create?employee=<%= employee._id %>" class="btn-primary btn-sm w-full mt-2"><i class="fa-solid fa-plus"></i> Add Salary Structure</a>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Recent activity timeline -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <div class="card">
        <div class="card-body">
          <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-3">Recent Attendance</h3>
          <% if (recentAttendance.length) { %>
            <ul class="space-y-2 max-h-64 overflow-y-auto pr-1">
              <% recentAttendance.forEach(function(a) { %>
                <li class="flex items-center justify-between text-sm py-1.5 border-b border-slate-100 dark:border-slate-800 last:border-0">
                  <span><%= new Date(a.date).toLocaleDateString() %></span>
                  <% var sc = { present:'badge-success', absent:'badge-danger', late:'badge-warning', 'half-day':'badge-info', leave:'badge-muted', holiday:'badge-muted' }[a.status]; %>
                  <span class="<%= sc %> capitalize"><%= a.status %></span>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="text-center py-6 text-sm text-slate-400">No attendance records.</div>
          <% } %>
        </div>
      </div>
      <div class="card">
        <div class="card-body">
          <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-3">Recent Leaves</h3>
          <% if (recentLeaves.length) { %>
            <ul class="space-y-2 max-h-64 overflow-y-auto pr-1">
              <% recentLeaves.forEach(function(l) { %>
                <li class="flex items-center justify-between text-sm py-1.5 border-b border-slate-100 dark:border-slate-800 last:border-0">
                  <span><%= l.leaveType ? l.leaveType.name : 'Leave' %> · <%= l.days %> day(s)</span>
                  <% var sc = { pending:'badge-warning', approved:'badge-success', rejected:'badge-danger', cancelled:'badge-muted' }[l.status]; %>
                  <span class="<%= sc %> capitalize"><%= l.status %></span>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="text-center py-6 text-sm text-slate-400">No leave requests.</div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
