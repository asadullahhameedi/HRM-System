<header class="no-print sticky top-0 z-20 h-16 border-b border-slate-200/80 dark:border-slate-800 flex items-center gap-3 px-4 lg:px-6">

  <!-- Premium Zai-style sidebar toggle -->
  <button
    id="sidebar-toggle"
    type="button"
    class="sidebar-toggle group relative inline-flex items-center justify-center h-10 w-10 rounded-xl text-slate-600 dark:text-slate-300 transition-all duration-300 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-1 dark:focus-visible:ring-offset-slate-900 hover:shadow-md overflow-hidden"
    aria-label="Toggle Sidebar"
    aria-expanded="false"
    aria-controls="sidebar"
    title="Toggle Sidebar">
    <!-- Ripple background effect -->
    <span class="absolute inset-0 rounded-xl bg-slate-100 dark:bg-slate-800 scale-90 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 ease-out"></span>
    <!-- Brand accent glow on hover -->
    <span class="absolute inset-0 rounded-xl bg-brand-500/0 group-hover:bg-brand-500/10 transition-all duration-300 ease-out"></span>
    <!-- Animated hamburger ↔ close icon (Zai-style morphing) -->
    <span class="sidebar-toggle-icon relative block h-4 w-4 z-10">
      <span class="sb-bar absolute left-0 h-[2.5px] w-4 bg-current rounded-full transition-all duration-300 ease-out" style="top:3px; transform-origin:center;"></span>
      <span class="sb-bar absolute left-0 h-[2.5px] w-4 bg-current rounded-full transition-all duration-300 ease-out" style="top:8px; transform-origin:center;"></span>
      <span class="sb-bar absolute left-0 h-[2.5px] w-4 bg-current rounded-full transition-all duration-300 ease-out" style="top:13px; transform-origin:center;"></span>
    </span>
    <!-- Tooltip -->
    <span class="sidebar-toggle-tooltip pointer-events-none absolute top-full left-1/2 -translate-x-1/2 mt-2 whitespace-nowrap rounded-lg bg-slate-900 dark:bg-slate-700 px-3 py-1.5 text-xs font-medium text-white opacity-0 scale-95 group-hover:opacity-100 group-hover:scale-100 group-focus-visible:opacity-100 transition-all duration-200 z-50 shadow-lg">
      <span class="tooltip-text">Toggle Sidebar</span>
    </span>
  </button>

  <!-- Breadcrumb / page title -->
  <div class="hidden md:block min-w-0">
    <h1 class="text-base font-semibold text-slate-800 dark:text-slate-100 truncate"><%= typeof title !== 'undefined' ? title : '' %></h1>
  </div>

  <!-- Global search (command palette trigger) -->
  <form action="/employees/search" method="get" class="ml-auto hidden sm:block" id="global-search-form">
    <div class="relative">
      <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
      <input
        type="text"
        name="q"
        id="global-search"
        autocomplete="off"
        placeholder="Search employees..."
        class="input pl-10 pr-16 w-72 lg:w-96 cursor-pointer"
        style="height: 2.5rem;"
      />
      <kbd class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-semibold text-slate-400 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded px-1.5 py-0.5 font-mono pointer-events-none">⌘K</kbd>
      <div id="search-results" class="hidden absolute mt-2 w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl max-h-80 overflow-y-auto z-50"></div>
    </div>
  </form>

  <!-- Right actions -->
  <div class="ml-auto sm:ml-3 flex items-center gap-1">
    <!-- Notifications -->
    <a href="/leave" class="btn-icon text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 relative group" title="Notifications" aria-label="Notifications">
      <i class="fa-regular fa-bell text-lg"></i>
      <% if (typeof overview !== 'undefined' && overview && overview.pendingLeaves) { %>
        <span class="absolute top-1 right-1 min-w-[16px] h-4 px-1 bg-rose-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center ring-2 ring-white dark:ring-slate-900 animate-pulse-soft"><%= overview.pendingLeaves %></span>
      <% } %>
    </a>

    <!-- Theme quick toggle -->
    <button id="theme-quick-toggle" class="btn-icon text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 group" title="Toggle theme" aria-label="Toggle theme">
      <i class="fa-solid fa-circle-half-stroke text-lg"></i>
    </button>

    <!-- Divider -->
    <div class="hidden sm:block w-px h-6 bg-slate-200 dark:bg-slate-700 mx-1"></div>

    <!-- User menu (topbar dropdown — separate from sidebar profile) -->
    <div class="relative" id="user-menu">
      <button class="flex items-center gap-2 pl-1 pr-2 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" id="user-menu-btn" aria-label="User menu">
        <% if (user && user.avatar) { %>
          <img src="<%= user.avatar %>" class="w-8 h-8 rounded-full object-cover ring-2 ring-slate-200 dark:ring-slate-700" alt="Avatar" />
        <% } else { %>
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-sm font-semibold uppercase ring-2 ring-brand-500/20">
            <%= (user && (user.name || user.email)) ? (user.name || user.email).charAt(0) : '?' %>
          </div>
        <% } %>
        <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 hidden sm:block"></i>
      </button>
      <div id="user-menu-dropdown" class="hidden absolute right-0 mt-2 w-64 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl py-2 animate-scale-in origin-top-right">
        <!-- User info header -->
        <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800">
          <div class="flex items-center gap-3">
            <% if (user && user.avatar) { %>
              <img src="<%= user.avatar %>" class="w-10 h-10 rounded-full object-cover" alt="Avatar" />
            <% } else { %>
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-sm font-semibold uppercase">
                <%= (user && (user.name || user.email)) ? (user.name || user.email).charAt(0) : '?' %>
              </div>
            <% } %>
            <div class="min-w-0">
              <div class="text-sm font-semibold truncate text-slate-800 dark:text-slate-100"><%= user && user.name %></div>
              <div class="text-xs text-slate-500 truncate"><%= user && user.email %></div>
            </div>
          </div>
        </div>
        <!-- Menu items -->
        <a href="/profile" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
          <i class="fa-solid fa-user w-4 text-slate-400"></i> My Profile
        </a>
        <% if (user && user.role === 'admin') { %>
        <a href="/settings" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
          <i class="fa-solid fa-gear w-4 text-slate-400"></i> Settings
        </a>
        <% } %>
        <a href="/about" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
          <i class="fa-solid fa-circle-info w-4 text-slate-400"></i> About
        </a>
        <div class="border-t border-slate-100 dark:border-slate-800 my-1"></div>
        <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 text-sm text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors">
          <i class="fa-solid fa-right-from-bracket w-4"></i> Sign Out
        </a>
      </div>
    </div>
  </div>
</header>
