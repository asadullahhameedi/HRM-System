<%
var tabs = [
  { id: 'general',    label: 'General',     icon: 'building',            desc: 'Company info, currency, dates' },
  { id: 'payroll',    label: 'Payroll',     icon: 'file-invoice-dollar', desc: 'Salary, tax, overtime rules' },
  { id: 'attendance', label: 'Attendance',  icon: 'fingerprint',         desc: 'Hours, shifts, weekends' },
  { id: 'leave',      label: 'Leave',       icon: 'calendar-check',      desc: 'Policies, carry forward' },
  { id: 'appearance', label: 'Appearance',  icon: 'palette',             desc: 'Theme, colors, layout' },
  { id: 'audit',      label: 'Audit Logs',  icon: 'shield-halved',       desc: 'Activity history' },
];
%>

<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 flex items-center gap-2 no-print mb-4">
      <a href="/dashboard" class="hover:text-brand-600">Dashboard</a>
      <i class="fa-solid fa-chevron-right text-[8px]"></i>
      <a href="/settings" class="hover:text-brand-600">Settings</a>
      <i class="fa-solid fa-chevron-right text-[8px]"></i>
      <span class="text-slate-700 dark:text-slate-300 capitalize font-medium"><%= activeScope %></span>
    </nav>

    <!-- Premium page header -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 lg:p-8 text-white shadow-xl mb-6 no-print">
      <!-- Decorative blobs -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-brand-500/20 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-48 h-48 bg-violet-500/15 rounded-full translate-y-1/2 blur-3xl"></div>
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(white 1px, transparent 1px), linear-gradient(90deg, white 1px, transparent 1px); background-size: 24px 24px;"></div>

      <div class="relative flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center shadow-lg shadow-brand-900/50 ring-1 ring-white/10 shrink-0">
            <i class="fa-solid fa-<%= icon %> text-white text-2xl"></i>
          </div>
          <div>
            <h2 class="text-2xl lg:text-3xl font-bold tracking-tight"><%= title %></h2>
            <p class="text-sm text-slate-300 mt-1">Configure <%= activeScope %> settings for the entire system.</p>
          </div>
        </div>
        <button onclick="HRM_Print.printPage()" class="no-print inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 backdrop-blur-sm text-sm font-medium text-white transition-all duration-200 hover:shadow-lg border border-white/10">
          <i class="fa-solid fa-print"></i> Print
        </button>
      </div>
    </div>

    <!-- Settings layout: sidebar tabs + content -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

      <!-- Vertical tab navigation -->
      <aside class="lg:col-span-1 no-print">
        <div class="card sticky top-20 overflow-hidden">
          <div class="card-body p-3">
            <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400 px-3 py-2">Settings Menu</div>
            <nav class="space-y-1">
              <% tabs.forEach(function(t) { %>
                <a href="/settings/<%= t.id %>"
                   class="settings-tab-link group flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition-all duration-200
                          <%= activeScope === t.id
                            ? 'bg-gradient-to-r from-brand-600 to-brand-500 text-white shadow-md shadow-brand-500/30'
                            : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                  <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 transition-transform duration-200
                              <%= activeScope === t.id
                                ? 'bg-white/20 text-white'
                                : 'bg-slate-100 dark:bg-slate-800 text-slate-500 group-hover:scale-110' %>">
                    <i class="fa-solid fa-<%= t.icon %> text-xs"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium truncate"><%= t.label %></div>
                    <div class="text-[10px] <%= activeScope === t.id ? 'text-white/70' : 'text-slate-400' %> truncate"><%= t.desc %></div>
                  </div>
                  <% if (activeScope === t.id) { %>
                    <i class="fa-solid fa-chevron-right text-white/70 text-xs shrink-0"></i>
                  <% } %>
                </a>
              <% }) %>
            </nav>
          </div>
        </div>

        <!-- Quick info card -->
        <div class="card mt-4">
          <div class="card-body p-4">
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                <i class="fa-solid fa-circle-info text-xs"></i>
              </div>
              <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Need help?</span>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">Settings apply system-wide. Changes take effect immediately after saving. Some changes may require a page refresh.</p>
          </div>
        </div>
      </aside>

      <!-- Active scope form -->
      <div class="lg:col-span-3" id="settings-form-wrapper">
        <%- formBody %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
