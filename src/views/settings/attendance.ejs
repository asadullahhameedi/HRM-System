<form method="post" action="/settings/attendance" class="space-y-6">
  <!-- Working Hours & Grace -->
  <div class="card">
    <div class="card-body">
      <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
        <div class="w-11 h-11 rounded-xl bg-brand-50 dark:bg-brand-500/10 flex items-center justify-center text-brand-600 dark:text-brand-400">
          <i class="fa-solid fa-clock text-lg"></i>
        </div>
        <div class="flex-1">
          <h3 class="font-semibold text-slate-800 dark:text-slate-100">Working Hours &amp; Grace</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Standard working hours and late arrival rules</p>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div>
          <label class="label">Working Hours / Day</label>
          <input type="number" step="0.5" name="workingHoursPerDay" value="<%= settings.workingHoursPerDay || 8 %>" class="input" min="1" max="24" />
        </div>
        <div>
          <label class="label">Standard Check-In Time</label>
          <input type="time" name="checkInTime" value="<%= settings.checkInTime || '09:00' %>" class="input" />
        </div>
        <div>
          <label class="label">Standard Check-Out Time</label>
          <input type="time" name="checkOutTime" value="<%= settings.checkOutTime || '17:00' %>" class="input" />
        </div>
        <div>
          <label class="label">Late Grace Period (minutes)</label>
          <input type="number" name="lateGraceMinutes" value="<%= settings.lateGraceMinutes || 10 %>" class="input" min="0" />
        </div>
        <div>
          <label class="label">Break Duration (minutes)</label>
          <input type="number" name="breakMinutes" value="<%= settings.breakMinutes || 60 %>" class="input" min="0" />
        </div>
        <div class="flex flex-col gap-3 pt-6">
          <label class="settings-toggle-card flex items-center gap-3 rounded-xl border-2 border-slate-200 dark:border-slate-700 p-3 cursor-pointer hover:border-brand-400 transition-all">
            <input type="checkbox" name="flexibleHours" <%= settings.flexibleHours ? 'checked' : '' %> class="w-5 h-5 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
            <div class="flex-1">
              <div class="text-sm font-medium flex items-center gap-1.5"><i class="fa-solid fa-clock-rotate-left text-brand-500"></i> Flexible Hours</div>
              <div class="text-xs text-slate-500">Allow flexible start times</div>
            </div>
          </label>
          <label class="settings-toggle-card flex items-center gap-3 rounded-xl border-2 border-slate-200 dark:border-slate-700 p-3 cursor-pointer hover:border-brand-400 transition-all">
            <input type="checkbox" name="autoOvertime" <%= settings.autoOvertime !== false ? 'checked' : '' %> class="w-5 h-5 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
            <div class="flex-1">
              <div class="text-sm font-medium flex items-center gap-1.5"><i class="fa-solid fa-stopwatch text-brand-500"></i> Auto-calculate Overtime</div>
              <div class="text-xs text-slate-500">Automatically compute OT hours</div>
            </div>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Weekend Rules -->
  <div class="card">
    <div class="card-body">
      <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
        <div class="w-11 h-11 rounded-xl bg-sky-50 dark:bg-sky-500/10 flex items-center justify-center text-sky-600 dark:text-sky-400">
          <i class="fa-solid fa-calendar-week text-lg"></i>
        </div>
        <div class="flex-1">
          <h3 class="font-semibold text-slate-800 dark:text-slate-100">Weekend Rules</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Select which days of the week are non-working days</p>
        </div>
      </div>
      <div class="grid grid-cols-3 sm:grid-cols-7 gap-3">
        <% var days = [{n:0,l:'Sun',full:'Sunday'},{n:1,l:'Mon',full:'Monday'},{n:2,l:'Tue',full:'Tuesday'},{n:3,l:'Wed',full:'Wednesday'},{n:4,l:'Thu',full:'Thursday'},{n:5,l:'Fri',full:'Friday'},{n:6,l:'Sat',full:'Saturday'}];
           var weekend = settings.weekendDays || [5]; %>
        <% days.forEach(function(d){ %>
          <label class="settings-day-card flex flex-col items-center justify-center gap-2 rounded-xl border-2 p-5 cursor-pointer transition-all
                       <%= weekend.indexOf(d.n) !== -1 ? 'border-brand-500 bg-brand-50 dark:bg-brand-500/10 text-brand-700 dark:text-brand-300' : 'border-slate-200 dark:border-slate-700 hover:border-slate-300' %>"
               title="<%= d.full %>">
            <input type="checkbox" name="weekendDays" value="<%= d.n %>" <%= weekend.indexOf(d.n) !== -1 ? 'checked' : '' %> class="w-5 h-5 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
            <span class="text-sm font-bold"><%= d.l %></span>
            <% if (weekend.indexOf(d.n) !== -1) { %>
              <i class="fa-solid fa-check text-brand-500 text-xs"></i>
            <% } %>
          </label>
        <% }) %>
      </div>
      <p class="help-text mt-4"><i class="fa-solid fa-circle-info mr-1"></i> Selected days are treated as non-working (weekend) days for attendance and payroll calculations.</p>
    </div>
  </div>

  <!-- Sticky action bar -->
  <div class="sticky bottom-4 z-10 no-print">
    <div class="card shadow-xl">
      <div class="card-body p-4 flex items-center justify-between">
        <div class="flex items-center gap-2 text-sm text-slate-500">
          <i class="fa-solid fa-circle-info text-brand-500"></i>
          <span>Attendance rules affect daily attendance recording.</span>
        </div>
        <div class="flex gap-3">
          <a href="/settings/attendance" class="btn-secondary"><i class="fa-solid fa-rotate-left"></i> Reset</a>
          <button type="submit" class="btn-primary"><i class="fa-solid fa-save"></i> Save Changes</button>
        </div>
      </div>
    </div>
  </div>
</form>
