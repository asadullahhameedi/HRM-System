
<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/dashboard" class="hover:text-brand-600">Dashboard</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-slate-700 dark:text-slate-300 font-medium">Attendance</span>
        </div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Attendance</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400"><%= pagination.total %> total records</p>
      </div>
      <div class="flex gap-2 no-print">
        <button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
        <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
          <button class="btn-primary btn-sm" data-modal-open="att-modal" data-modal-title="Record Attendance"><i class="fa-solid fa-plus"></i> Record Attendance</button>
        <% } %>
      </div>
    </div>

    <form method="get" class="card p-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <div><label class="label">Employee</label><select name="employee" class="input"><option value="">All Employees</option><% employees.forEach(function(e){ %><option value="<%= e._id %>" <%= filters.employee==e._id?'selected':'' %>><%= e.employeeId %> · <%= e.firstName %> <%= e.lastName %></option><% }) %></select></div>
        <div><label class="label">Status</label><select name="status" class="input"><option value="">All Statuses</option><% ['present','absent','late','half-day','leave','holiday'].forEach(function(s){ %><option value="<%= s %>" <%= filters.status==s?'selected':'' %>><%= s %></option><% }) %></select></div>
        <div><label class="label">From</label><input type="date" name="from" value="<%= filters.from || '' %>" class="input" /></div>
        <div><label class="label">To</label><input type="date" name="to" value="<%= filters.to || '' %>" class="input" /></div>
        <div class="flex items-end gap-2"><button class="btn-primary flex-1"><i class="fa-solid fa-filter"></i> Apply</button><a href="/attendance" class="btn-secondary" title="Reset"><i class="fa-solid fa-rotate-left"></i></a></div>
      </div>
    </form>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <% if (records.length) { %>
          <table class="table-clean">
            <thead><tr><th>Employee</th><th>Date</th><th>Status</th><th>Check In</th><th>Check Out</th><th>Hours</th><th>OT</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
              <% records.forEach(function(r) { %>
                <tr>
                  <td><div class="flex items-center gap-2"><% if (r.employee && r.employee.avatar) { %><img src="<%= r.employee.avatar %>" class="w-8 h-8 rounded-full object-cover" alt="Avatar" /><% } else { %><div class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs font-semibold uppercase"><%= r.employee ? (r.employee.firstName || '?').charAt(0) + (r.employee.lastName || '').charAt(0) : '?' %></div><% } %><div><div class="font-medium"><%= r.employee ? r.employee.firstName+' '+r.employee.lastName : 'Unknown' %></div><div class="text-xs text-slate-500"><%= r.employee ? r.employee.employeeId : '' %></div></div></div></td>
                  <td class="text-sm"><%= new Date(r.date).toLocaleDateString() %></td>
                  <td><% var sc={present:'badge-success',absent:'badge-danger',late:'badge-warning','half-day':'badge-info',leave:'badge-muted',holiday:'badge-muted'}[r.status]; %><span class="<%= sc %> capitalize"><%= r.status %></span></td>
                  <td class="text-sm"><%= r.checkIn ? new Date(r.checkIn).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) : '—' %></td>
                  <td class="text-sm"><%= r.checkOut ? new Date(r.checkOut).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) : '—' %></td>
                  <td class="text-sm"><%= r.workHours %></td>
                  <td class="text-sm"><%= r.overtimeHours %></td>
                  <td class="text-right">
                    <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
                      <button class="btn-icon btn-ghost btn-sm" data-modal-open="att-edit-modal" data-modal-id="<%= r._id %>" data-modal-employee="<%= r.employee ? r.employee._id : '' %>" data-modal-employee-name="<%= r.employee ? r.employee.firstName+' '+r.employee.lastName : '' %>" data-modal-date="<%= new Date(r.date).toISOString().slice(0,10) %>" data-modal-status="<%= r.status %>" data-modal-checkin="<%= r.checkIn ? new Date(r.checkIn).toISOString().slice(0,16) : '' %>" data-modal-checkout="<%= r.checkOut ? new Date(r.checkOut).toISOString().slice(0,16) : '' %>" data-modal-overtime="<%= r.overtimeHours %>" data-modal-remarks="<%= r.remarks || '' %>" title="Edit"><i class="fa-solid fa-pen"></i></button>
                      <button class="btn-icon btn-ghost btn-sm text-rose-600" data-confirm="Delete attendance record?" data-confirm-action="/attendance/<%= r._id %>?_method=DELETE" data-confirm-method="POST" title="Delete"><i class="fa-solid fa-trash"></i></button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-20">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i class="fa-regular fa-calendar-xmark text-2xl text-slate-400"></i>
            </div>
            <h3 class="font-semibold text-slate-700 dark:text-slate-300">No attendance records</h3>
            <p class="text-sm text-slate-400 mt-1">Try adjusting your filters.</p>
          </div>
        <% } %>
      </div>
    </div>

    <%- include('../partials/pagination', { pagination, query: filters }) %>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
<%- include('../partials/confirm-modal') %>

<div id="att-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" data-modal-close></div>
  <div class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-2xl w-full max-w-lg p-6 animate-scale-in">
    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-4">Record Attendance</h3>
    <form method="post" action="/attendance" class="space-y-3">
      <div><label class="label">Employee *</label><select name="employee" class="input" required><option value="">Select</option><% employees.forEach(function(e){ %><option value="<%= e._id %>"><%= e.employeeId %> · <%= e.firstName %> <%= e.lastName %></option><% }) %></select></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="label">Date *</label><input type="date" name="date" id="att-create-date" class="input" required /></div>
        <div><label class="label">Status</label><select name="status" class="input"><% ['present','absent','late','half-day','leave','holiday'].forEach(function(s){ %><option value="<%= s %>"><%= s %></option><% }) %></select></div>
        <div><label class="label">Check In</label><input type="datetime-local" name="checkIn" class="input" /></div>
        <div><label class="label">Check Out</label><input type="datetime-local" name="checkOut" class="input" /></div>
        <div><label class="label">Overtime Hours</label><input type="number" step="0.5" name="overtimeHours" value="0" class="input" /></div>
      </div>
      <div><label class="label">Remarks</label><textarea name="remarks" class="input" rows="2"></textarea></div>
      <div class="flex justify-end gap-2 pt-2"><button type="button" class="btn-secondary" data-modal-close>Cancel</button><button class="btn-primary">Save</button></div>
    </form>
  </div>
</div>

<!-- Edit Attendance Modal -->
<div id="att-edit-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" data-modal-close></div>
  <div class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-2xl w-full max-w-lg p-6 animate-scale-in">
    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-4">Edit Attendance</h3>
    <form id="att-edit-form" method="post" action="" class="space-y-3">
      <input type="hidden" name="_method" value="PUT" />
      <div><label class="label">Employee</label><div id="att-edit-employee-name" class="input bg-slate-100 dark:bg-slate-800"></div></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="label">Date *</label><input type="date" name="date" id="att-edit-date" class="input" required /></div>
        <div><label class="label">Status</label><select name="status" id="att-edit-status" class="input"><% ['present','absent','late','half-day','leave','holiday'].forEach(function(s){ %><option value="<%= s %>"><%= s %></option><% }) %></select></div>
        <div><label class="label">Check In</label><input type="datetime-local" name="checkIn" id="att-edit-checkin" class="input" /></div>
        <div><label class="label">Check Out</label><input type="datetime-local" name="checkOut" id="att-edit-checkout" class="input" /></div>
        <div><label class="label">Overtime Hours</label><input type="number" step="0.5" name="overtimeHours" id="att-edit-overtime" class="input" /></div>
      </div>
      <div><label class="label">Remarks</label><textarea name="remarks" id="att-edit-remarks" class="input" rows="2"></textarea></div>
      <div class="flex justify-end gap-2 pt-2"><button type="button" class="btn-secondary" data-modal-close>Cancel</button><button class="btn-primary">Update</button></div>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll('[data-modal-open="att-edit-modal"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var modal = document.getElementById('att-edit-modal');
      var id = btn.getAttribute('data-modal-id');
      document.getElementById('att-edit-form').action = '/attendance/' + id + '?_method=PUT';
      document.getElementById('att-edit-employee-name').textContent = btn.getAttribute('data-modal-employee-name') || '—';
      document.getElementById('att-edit-date').value = btn.getAttribute('data-modal-date') || '';
      document.getElementById('att-edit-status').value = btn.getAttribute('data-modal-status') || 'present';
      document.getElementById('att-edit-checkin').value = btn.getAttribute('data-modal-checkin') || '';
      document.getElementById('att-edit-checkout').value = btn.getAttribute('data-modal-checkout') || '';
      document.getElementById('att-edit-overtime').value = btn.getAttribute('data-modal-overtime') || 0;
      document.getElementById('att-edit-remarks').value = btn.getAttribute('data-modal-remarks') || '';
      modal.classList.remove('hidden');
    });
  });
</script>

<script>
  // Disable holiday dates in both date pickers
  var holidayDates = <%- JSON.stringify(holidayDates || []) %>;
  function isHoliday(dateStr) { return holidayDates.indexOf(dateStr) !== -1; }

  // For the create modal date picker
  var createDate = document.getElementById('att-create-date');
  if (createDate) {
    createDate.addEventListener('change', function() {
      if (isHoliday(this.value)) {
        alert('This date is a holiday. Attendance cannot be recorded on holidays.');
        this.value = '';
      }
    });
  }

  // For the edit modal date picker
  var editDate = document.getElementById('att-edit-date');
  if (editDate) {
    editDate.addEventListener('change', function() {
      if (isHoliday(this.value)) {
        alert('This date is a holiday. Attendance cannot be recorded on holidays.');
        this.value = '';
      }
    });
  }
</script>
