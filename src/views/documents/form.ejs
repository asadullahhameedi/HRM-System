<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5 max-w-4xl">
    <nav class="text-sm text-slate-500 flex items-center gap-2">
      <a href="/documents" class="hover:text-brand-600">Documents</a>
      <i class="fa-solid fa-chevron-right text-xs"></i>
      <span class="text-slate-700 dark:text-slate-300"><%= isEdit ? 'Edit' : 'New' %></span>
    </nav>

    <form action="<%= isEdit ? '/documents/' + doc._id + '?_method=PUT' : '/documents' %>" method="post" enctype="multipart/form-data" class="space-y-5">
      <div class="card">
        <div class="card-body space-y-4">
          <h3 class="font-semibold text-slate-800 dark:text-slate-100"><i class="fa-solid fa-file-lines mr-2 text-brand-600"></i><%= isEdit ? 'Edit Document' : 'New Document' %></h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="sm:col-span-2"><label class="label">Title *</label><input name="title" value="<%= doc.title || '' %>" class="input" required /></div>

            <div>
              <label class="label">Type *</label>
              <select name="type" class="input" required>
                <% docTypes.forEach(function(t){ %><option value="<%= t.value %>" <%= doc.type===t.value?'selected':'' %>><%= t.label %></option><% }) %>
              </select>
            </div>
            <div>
              <label class="label">Status</label>
              <select name="status" class="input">
                <% ['draft','pending','approved','rejected','archived','expired'].forEach(function(s){ %><option value="<%= s %>" <%= (doc.status||'draft')===s?'selected':'' %>><%= s %></option><% }) %>
              </select>
            </div>

            <div>
              <label class="label">Employee</label>
              <select name="employee" class="input">
                <option value="">— None —</option>
                <% employees.forEach(function(e){ %><option value="<%= e._id %>" <%= (doc.employee && (doc.employee._id || doc.employee)==e._id)?'selected':'' %>><%= e.employeeId %> · <%= e.firstName %> <%= e.lastName %></option><% }) %>
              </select>
            </div>

            <div><label class="label">Issued Date</label><input type="date" name="issuedDate" value="<%= doc.issuedDate ? new Date(doc.issuedDate).toISOString().slice(0,10) : '' %>" class="input" /></div>
            <div><label class="label">Expiry Date</label><input type="date" name="expiryDate" value="<%= doc.expiryDate ? new Date(doc.expiryDate).toISOString().slice(0,10) : '' %>" class="input" /></div>

            <div class="sm:col-span-2"><label class="label">Description</label><textarea name="description" rows="3" class="input"><%= doc.description || '' %></textarea></div>

            <div class="sm:col-span-2">
              <label class="label">File</label>
              <input type="file" name="file" class="input" />
              <% if (isEdit && doc.fileName) { %>
                <p class="text-xs text-slate-500 mt-1"><i class="fa-solid fa-paperclip"></i> Current: <%= doc.fileName %> (<%= (doc.fileSize/1024).toFixed(1) %> KB). Upload a new file to replace & version up.</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-2">
        <a href="/documents" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary"><i class="fa-solid fa-save"></i> <%= isEdit ? 'Update' : 'Create' %> Document</button>
      </div>
    </form>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
