<div class="flex-1 lg:pl-64 flex flex-col">
  <%- include('../partials/topbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-1 p-4 lg:p-6 space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/dashboard" class="hover:text-brand-600">Dashboard</a>
          <i class="fa-solid fa-chevron-right text-[8px]"></i>
          <span class="text-slate-700 dark:text-slate-300 font-medium">Documents</span>
        </div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Documents</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400"><%= pagination.total %> total documents</p>
      </div>
      <div class="flex gap-2 no-print">
        <button onclick="HRM_Print.printPage()" class="btn-secondary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
        <% if (['admin','hr'].indexOf(user.role) !== -1) { %>
          <a href="/documents/create" class="btn-primary btn-sm"><i class="fa-solid fa-plus"></i> New Document</a>
        <% } %>
      </div>
    </div>

    <!-- Filters -->
    <form method="get" class="card p-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <div class="lg:col-span-2">
          <label class="label">Search</label>
          <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
            <input type="text" name="search" value="<%= filters.search || '' %>" class="input pl-10" placeholder="Title, doc number, description..." />
          </div>
        </div>
        <div>
          <label class="label">Type</label>
          <select name="type" class="input">
            <option value="">All Types</option>
            <% docTypes.forEach(function(t){ %><option value="<%= t.value %>" <%= filters.type==t.value?'selected':'' %>><%= t.label %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="label">Status</label>
          <select name="status" class="input">
            <option value="">All Statuses</option>
            <% ['draft','pending','approved','rejected','archived','expired'].forEach(function(s){ %><option value="<%= s %>" <%= filters.status==s?'selected':'' %>><%= s %></option><% }) %>
          </select>
        </div>
        <div class="flex items-end gap-2">
          <button class="btn-primary flex-1"><i class="fa-solid fa-filter"></i> Apply</button>
          <a href="/documents" class="btn-secondary" title="Reset"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
      </div>
    </form>

    <!-- Grid -->
    <% if (documents.length) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% documents.forEach(function(d) { %>
          <% var typeMeta = docTypes.find(function(t){ return t.value === d.type; }) || { icon: 'fa-file', label: d.type }; %>
          <a href="/documents/<%= d._id %>" class="card hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5 group">
            <div class="card-body">
              <div class="flex items-start gap-3">
                <div class="w-12 h-12 rounded-xl bg-brand-50 dark:bg-brand-500/10 flex items-center justify-center shrink-0 text-brand-600 dark:text-brand-400 group-hover:scale-110 transition-transform">
                  <i class="fa-solid <%= typeMeta.icon %> text-lg"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-slate-800 dark:text-slate-100 truncate"><%= d.title %></div>
                  <div class="text-xs text-slate-500 mt-0.5 font-mono"><%= d.docNumber %></div>
                </div>
                <% var sc = {draft:'badge-muted', pending:'badge-warning', approved:'badge-success', rejected:'badge-danger', archived:'badge-muted', expired:'badge-danger'}[d.status]; %>
                <span class="<%= sc %> capitalize text-[10px]"><%= d.status %></span>
              </div>
              <div class="mt-3 space-y-1 text-xs text-slate-500">
                <div class="flex items-center gap-2"><i class="fa-solid fa-tag w-4"></i><%= typeMeta.label %></div>
                <% if (d.employee) { %><div class="flex items-center gap-2"><i class="fa-solid fa-user w-4"></i><%= d.employee.firstName %> <%= d.employee.lastName %></div><% } %>
                <% if (d.department) { %><div class="flex items-center gap-2"><i class="fa-solid fa-building w-4"></i><%= d.department.name %></div><% } %>
                <div class="flex items-center gap-2"><i class="fa-regular fa-calendar w-4"></i><%= d.issuedDate ? new Date(d.issuedDate).toLocaleDateString() : '—' %></div>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="card">
        <div class="text-center py-20">
          <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
            <i class="fa-regular fa-folder-open text-2xl text-slate-400"></i>
          </div>
          <h3 class="font-semibold text-slate-700 dark:text-slate-300">No documents found</h3>
          <p class="text-sm text-slate-400 mt-1">Try adjusting filters or create a new document.</p>
        </div>
      </div>
    <% } %>

    <%- include('../partials/pagination', { pagination, query: filters }) %>
  </main>

  <%- include('../partials/footer') %>
</div>
<%- include('../partials/sidebar') %>
